@code {

    UsuarioTokenDTO UsuarioTokenDTO;
    bool multiple = true;
    private bool intMenuLogistico = false;
    private bool intMenuWMSAutos = false;
    private bool intMenuWMSMovilAutos = false;
    private bool intOpcionVacios = false;
    private bool intOpcionAcarreo = false;
    private bool intOpcionUltimaMilla = false;
    private bool intOpcionSolicitud = false;
    private bool intOpcionSLOReferencias = false;
    private bool intUsuarioValido = false;
    //EventConsole console;

    void OnParentClicked(MenuItemEventArgs args)
    {
        // console.Log($"{args.Text} clicked from parent");
    }

    void OnChildClicked(MenuItemEventArgs args)
    {
        //console.Log($"{args.Text} from child clicked");
    }

    protected override async Task OnInitializedAsync()
    {

        UsuarioTokenDTO = new UsuarioTokenDTO();

        #region ValidarAcceso
        try
        {
            //////Console.WriteLine($"INIT APP MENU:" + _UsuarioTokenDTO.IdCatUsuario);
            if (_UsuarioTokenDTO is null || _UsuarioTokenDTO.IdCatUsuario == 0)
            {
                ////Console.WriteLine($"ENTRO APP MENU");
                _UsuarioTokenDTO = await loginService.ObtenerdatosToken();
                //await UserService.InitializeAsync();
                if (_UsuarioTokenDTO is null)
                {
                    _navigationManager.NavigateTo("/");
                }
                ////Console.WriteLine($"SALIO APP MENU {_UsuarioTokenDTO.Nombre}");

                intMenuLogistico = _UsuarioTokenDTO.catUsuarios.catUsuariosPermisos.Any(cp => cp.IdCatPermisos == 2);
                intOpcionVacios = _UsuarioTokenDTO.catUsuarios.catUsuariosPermisos.Any(cp => cp.IdCatPermisos == 10);
                intOpcionAcarreo = _UsuarioTokenDTO.catUsuarios.catUsuariosPermisos.Any(cp => cp.IdCatPermisos == 3);
                intOpcionUltimaMilla = _UsuarioTokenDTO.catUsuarios.catUsuariosPermisos.Any(cp => cp.IdCatPermisos == 4);
                intOpcionSolicitud = _UsuarioTokenDTO.catUsuarios.catUsuariosPermisos.Any(cp => cp.IdCatPermisos == 2);
                intOpcionSLOReferencias = _UsuarioTokenDTO.catUsuarios.catUsuariosPermisos.Any(cp => cp.IdCatPermisos == 2);
                intUsuarioValido = true;
            }
        }

        catch (Exception ex)
        {
            ////Console.WriteLine($"SALIO APP MENU ERROR {ex.Message}");
            _navigationManager.NavigateTo("/");
        }

        await InvokeAsync(StateHasChanged);

        #endregion ValidarAcceso
    }

}
