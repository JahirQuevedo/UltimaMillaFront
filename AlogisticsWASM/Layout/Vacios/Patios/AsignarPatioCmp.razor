@page "/patios"
@using AlogisticsWASM.Layout.Utilerias
@using ALOG.Modelos.Modelos.Catalogos
@* @using Radzen
@using Radzen.Blazor *@

<style>
    .contenedor-principal-animado {
    overflow-x: hidden;
    position: relative;
    }

    @@keyframes slideInRight {
    0% {
    opacity: 0;
    transform: translateX(100%);
    }

    100% {
    opacity: 1;
    transform: translateX(0);
    }
    }

    @@keyframes slideOutRight {
    0% {
    opacity: 1;
    transform: translateX(0);
    }

    100% {
    opacity: 0;
    transform: translateX(100%);
    }
    }

    .slide-in {
    animation: slideInRight 0.4s ease-out forwards;
    }

    .slide-out {
    animation: slideOutRight 0.4s ease-in forwards;
    }

    .column-transicion-suave {
    transition: width 0.4s ease;
    }
</style>

<div class="contenedor-principal-animado">
    <RadzenRow JustifyContent="JustifyContent.Center"
    AlignItems="AlignItems.Center" Gap="2rem" class="layout-estable">
        @if (_isLoading) {
            <p>Cargando ... </p>
        } else {
            <!-- Campo de búsqueda para filtrar patios -->
            <RadzenColumn Size="12" class="rz-text-align-center rz-p-2">
                <RadzenFormField Text="Razón social patio" Variant="Variant.Outlined">
                    <RadzenTextBox @bind-Value="BusquedaPatio" />
                </RadzenFormField>
            </RadzenColumn>

            <!-- DataGrid con selección única a través de @bind-Value -->
            <RadzenColumn Size="@_sizeColumns" class="rz-text-align-center rz-p-2">
                <RadzenDataGrid TItem="CatPatios"
                @ref="_gridPatios"
                Data="@_patios"
                SelectionMode="DataGridSelectionMode.Single"
                @bind-Value="PatioSeleccionado"
                AllowFiltering="true"
                AllowSorting="true"
                AllowPaging="true"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                FilterPopupRenderMode="PopupRenderMode.OnDemand"
                ColumnWidth="200px"
                PageSize="4">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(CatProveedores.RazonSocial)"
                        Title="Patio" />
                    </Columns>
                </RadzenDataGrid>
            </RadzenColumn>

            <!-- Formularios condicionales: se mostrarán según la validación de RFC -->

            <RadzenColumn Size="@_sizeColumns" class="@DetallePatioAnimacion">

                @if (_esPatioHazesa) {
                    <RadzenFieldset Text="Datos del chofer a ingresar (Hazesa)">
                        <RadzenStack Gap="1rem">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Nombre completo" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="_nombreChofer" Style="width: 100%;" />
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Número de licencia" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="_numeroLicenciaChofer" Style="width: 100%;" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>
                    <RadzenFieldset Text="Datos de la unidad a ingresar">
                        <RadzenStack Gap="1rem">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Número de la unidad" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="_numeroUnidad" Style="width: 100%;" />
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Placas" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="_numeroPlacas" Style="width: 100%;" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>
                }
                @if (_esNavieraHyundai) {
                    <RadzenFieldset Text="Datos complementarios (Hyundai)">
                        <RadzenStack Gap="1rem">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Comentarios" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="_comentarios" Style="width: 100%;" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenFieldset>
                }
            </RadzenColumn>

            


            @* @if (_esPatioHazesa) {
                <RadzenColumn Size="6" class="@DetallePatioAnimacion">
                    <RadzenFieldset Text="Datos complementarios (Hazesa)">
