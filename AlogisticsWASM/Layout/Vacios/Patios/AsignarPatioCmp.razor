                    </RadzenFieldset>
                </RadzenColumn>
            } *@

            <RadzenColumn Size="12" class="rz-text-align-center rz-p-2">
                <RadzenButton Click="Aceptar" Text="Aceptar" ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton Click="Cancelar" Text="Cancelar" ButtonStyle="ButtonStyle.Secondary" />
            </RadzenColumn>
        }
    </RadzenRow>
</div>

