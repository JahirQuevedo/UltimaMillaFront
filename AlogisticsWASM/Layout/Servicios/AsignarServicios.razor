<!-- Modal -->
<div class="modal fade" id="modalServicios" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @* <div class="card-header border-bottom-0 pb-0"> *@
                    <div class="row justify-content-between align-items-center mb-4">
                        <div class="col-6">
                            <h3 class="text-body-emphasis">Servicios</h3>
                            <p class="mb-2 mb-md-0 mb-lg-2 text-body-tertiary">Servicios disponibles para facturar</p>
                        </div>
                        <div class="col-6 w-100 w-md-auto">
                            <div class="row align-items-center g-0 justify-content-between">
                                <div class="col-12 col-sm-auto">
                                    <div class="search-box w-100 mb-2 mb-sm-0" style="max-width:30rem;">
                                        <form class="position-relative">
                                        <input class="form-control search-input search" type="search" placeholder="Buscar por nombre de servicio" aria-label="Search" @bind:get="NombreServicioFiltrar" @bind:set="BuscarPorNombreServicio" @bind:event="oninput" />
                                            <span class="fas fa-search search-box-icon"></span>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                @* </div> *@
            </div>
            <div class="modal-body">
                <div class="card-body py-0 px-1 scrollbar to-do-list-body">

                    @foreach (var servicio in ServciosFiltrados) {
                        <div class="d-flex hover-actions-trigger py-3 border-translucent border-top">
                            <input class="form-check-input flex-shrink-0 my-1 me-2 form-check-input-undefined" type="checkbox" id="checkbox-todo-0" data-event-propagation-prevent="data-event-propagation-prevent" @bind=servicio.IsSelected />
                            <div class="row justify-content-between align-items-md-center btn-reveal-trigger border-translucent gx-0 flex-1">
                                <div class="col-12 col-md-auto col-xl-12 col-xxl-auto">
                                    <div class="mb-1 mb-md-0 d-flex align-items-center lh-1">
                                        <label class="form-check-label mb-1 mb-md-0 mb-xl-1 mb-xxl-0 fs-8 me-2 line-clamp-1 text-body">@servicio.Nombre</label>
                                    </div>
                                </div>
                                @* <div class="col-12 col-md-auto col-xl-12 col-xxl-auto">
                                    <div class="d-flex lh-1 align-items-center">
                                        <p class="text-body-tertiary fs-10 mb-md-0 me-2 me-md-3 me-xl-2 me-xxl-3 mb-0">precio $</p>
                                        <p class="text-body-tertiary fs-10 fw-bold mb-md-0 mb-0 ps-md-3 ps-xl-0 ps-xxl-3 border-start-md border-xl-0 border-start-xxl">Precio (con IVA) $ @servicio.Precio.ToString("C")</p>
                                    </div>
                                </div> *@
                            </div>
                        </div>
                    }

                    
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-phoenix-primary px-5" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary px-5 px-sm-15" data-bs-dismiss="modal" @onclick="EnviarServiciosSeleccionados">Asignar servicios</button>
            </div>
        </div>
    </div>
</div>
