                    }

                }
            };
            // Invocar la función de JavaScript para crear el gráfico
            await JS.InvokeVoidAsync("createChart", chartData);
        } catch (Exception ex) {
            Console.WriteLine($"Error al generar el gráfico: {ex.Message}");
        }
    }
}
