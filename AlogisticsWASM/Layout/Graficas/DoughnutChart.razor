
@inject IJSRuntime JS

<canvas id="myChart" width="400" height="200"></canvas>
<div></div>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            //await InitBarChartAsync();
            await InitChartDoughNutAsync();
            //await InitChartLineAsync();
        }
    }

    protected async Task InitBarChartAsync() {

        try {
            // Definir los datos del gráfico en un objeto de datos de JavaScript
            var chartData = new {
                type = "bar", // tipo de gráfico: barra
                data = new {
                    labels = new[] { "Red", "Blue", "Yellow", "Green", "Purple", "Orange" },
                    datasets = new[]
                    {
                        new {
                            label = "# of Votes",
                            data = new[] { 12, 19, 3, 5, 2, 3 },
                            backgroundColor = new[]
                            {
                                "rgba(255, 99, 132, 0.2)",
                                "rgba(54, 162, 235, 0.2)",
                                "rgba(255, 206, 86, 0.2)",
                                "rgba(75, 192, 192, 0.2)",
                                "rgba(153, 102, 255, 0.2)",
                                "rgba(255, 159, 64, 0.2)"
                            },
                            borderColor = new[]
                            {
                                "rgba(255, 99, 132, 1)",
                                "rgba(54, 162, 235, 1)",
                                "rgba(255, 206, 86, 1)",
                                "rgba(75, 192, 192, 1)",
                                "rgba(153, 102, 255, 1)",
                                "rgba(255, 159, 64, 1)"
                            },
                            borderWidth = 1
                        }
                    }
                },
                options = new {
                    scales = new {
                        y = new {
                            beginAtZero = true
                        }
                    }
                }
            };

            // Invocar la función de JavaScript para crear el gráfico
            await JS.InvokeVoidAsync("createChart", chartData);
        } catch (Exception ex) {
            Console.WriteLine($"Error al generar el gráfico: {ex.Message}");
        }
    }

    protected async Task InitChartDoughNutAsync() {

        try {
            // Definir los datos del gráfico en un objeto de datos de JavaScript
            var chartData = new {
                type = "doughnut", // tipo de gráfico: barra
                data = new {
                    labels = new[] { "Maniobras de vacío", "Gestión de EIR", "Recuperación de garantías", "Corte de demoras", "Formato ICA" },
                    datasets = new[]
                    {
                        new {
                            label = "",
                            data = new[] { 12, 19, 3, 5, 2 },
                            backgroundColor = new[]
                            {
                                "rgba(255, 99, 132, 1)",
                                "rgba(54, 162, 235, 1)",
                                "rgba(255, 206, 86, 1)",
                                "rgba(75, 192, 192, 1)",
                                "rgba(153, 102, 255,1)"
                            },
                            borderColor = new[]
                            {
                                "rgba(255, 99, 132, 1)",
                                "rgba(54, 162, 235, 1)",
                                "rgba(255, 206, 86, 1)",
                                "rgba(75, 192, 192, 1)",
                                "rgba(153, 102, 255, 1)"
                            },
                            borderWidth = 1
                        }
                    }
                }
            };

            // Invocar la función de JavaScript para crear el gráfico
            await JS.InvokeVoidAsync("createChart", chartData);
        } catch (Exception ex) {
            Console.WriteLine($"Error al generar el gráfico: {ex.Message}");
        }
    }

    protected async Task InitChartLineAsync() {

        try {
            var chartData = new {
                type = "line", // tipo de gráfico: barra
                data = new {
                    labels = new[] { "Enero", "Febrero", "Marzo", "Abril", "Mayo" },
                    datasets = new[]
                    {
                        new {
                            label = "Maniobras de vacío",
                            data = new[] { 12, 19, 3, 80, 90 },
                            backgroundColor = "rgba(255, 99, 132, 1)",
                            borderColor = "rgba(255, 99, 132, 1)",
                            borderWidth = 1
                        },
                        new {
                            label = "Gestión de EIR",
                            data = new[] { 22, 29, 55, 100, 80 },
                            backgroundColor = "rgba(54, 162, 235, 1)",
                            borderColor = "rgba(54, 162, 235, 1)",
                            borderWidth = 1
                        },
                        new {
                            label = "Recuperación de garantías",
                            data = new[] { 5, 39, 40, 35, 200 },
                            backgroundColor = "rgba(255, 206, 86, 1)",
                            borderColor = "rgba(255, 206, 86, 1)",
                            borderWidth = 1
                        },
                        new {
                            label = "Corte de demoras",
                            data = new[] { 42, 49, 5, 66, 88 },
                            backgroundColor = "rgba(75, 192, 192, 1)",
                            borderColor = "rgba(75, 192, 192, 1)",
                            borderWidth = 1
                        },
                        new {
                            label = "Formato ICA",
                            data = new[] { 52, 59, 53, 55, 52 },
                            backgroundColor = "rgba(153, 102, 255, 1)",
                            borderColor = "rgba(153, 102, 255, 1)",
