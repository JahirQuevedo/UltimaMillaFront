    @using ALOG.Modelos.Modelos.Logisticos
@using ALOGRepositorios.Services.Logisticos.ILogisticos
@using System.Linq
@using Radzen.Blazor 
@using ALOG.Modelos.Modelos.Catalogos

@inject Radzen.DialogService DialogService
@inject ISLOTControlTerrestreService servicioControl


<style>
    :root {
        --rz-grid-header-color: white;
        --rz-grid-header-background-color: darkred;
    }

    .rz-tabview-nav li a {
        color: black !important;
        border-radius: 8px;
        padding: 8px 16px;
    }

    .rz-tabview-nav li.rz-state-active a {
        background-color: rgba(255, 204, 0, 0.3);
        color: black !important;
    }

    .rz-tabview-nav {
        border-bottom: none;
    }

    .icon-container {
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
    }

    /* Contenedor específico para no romper otros layouts */
    .two-col-form .rz-column {
        padding-bottom: 0.75rem;
    }

    /* Alineación y separación de botones */
    .two-col-actions {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

        .two-col-actions .left,
        .two-col-actions .right {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

    /* En pantallas pequeñas forcemos una columna (cada RadzenColumn ocupará 100%) */
