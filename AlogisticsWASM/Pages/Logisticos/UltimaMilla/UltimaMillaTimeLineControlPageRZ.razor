<style>

    .display-zoom {
        zoom: 0.75;
    }

    :root {
        --rz-grid-header-color: white;
        --rz-grid-header-background-color: darkred;
    }

    .rz-tabview-nav li a {
        color: black !important;
        border-radius: 8px;
        padding: 8px 16px;
    }

    .rz-tabview-nav li.rz-state-active a {
        background-color: rgba(255, 204, 0, 0.3);
        color: black !important;
    }

    .rz-tabview-nav {
        border-bottom: none;
    }

    .icon-container {
        width: 28px;
        height: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
    }

    /* Contenedor específico para no romper otros layouts */
    .two-col-form .rz-column {
        padding-bottom: 0.75rem;
    }

    /* Alineación y separación de botones */
    .two-col-actions {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

        .two-col-actions .left,
        .two-col-actions .right {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

    /* En pantallas pequeñas forcemos una columna (cada RadzenColumn ocupará 100%) */
    /*  (max-width: 768px) {
        .two-col-form .rz-column

    {
        flex: 0 0 100% !important;
        max-width: 100% !important;
    }

    
    .two-col-actions {
        flex-direction: column;
        align-items: stretch;
    }

        .two-col-actions .right {
            margin-left: 0;
            justify-content: flex-end;
        }

    } */
/* sq */
  /*   .timeline-normal {
        padding: 0.5rem 0;
    }
    /* Opcional: para ocultar el punto del timeline original en eventos eventuales */
    /* .timeline-item-eventual .rz-timeline-point {
        display: none !important;
    } */ 
    /* ------------- “Chips” de Estado ------------- */
    .status-chip {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        text-align: center;
        min-width: 64px;
    }

    /* ABIERTO */
    .status-1 {
        background-color: #000000; /* negro */
        color: white;
    }

    /* EN PROCESO */
    .status-2 {
        background-color: #ffb425; /* naranja */
        color: black;
    }

    /* TERMINADO */
    .status-3 {
        background-color: #4caf50; /* verde */
        color: white;
    }

    /* CANCELADO */
    .status-4 {
        background-color: #f44336; /* rojo */
        color: white;
    }

    /* PENDIENTE */
    .status-5 {
        background-color: #9e9e9e; /* gris medio */
        color: white;
    }


    .chips-container {
        display: flex;
        gap: 0.25rem; /* Reducido para que estén casi pegadas */
        justify-content: flex-end;
        /* min-height: 50px; */
        /* margin-bottom: 0.5rem;
            padding-right: 1rem; */
    }

    .estado-chip {
        background-color: gray;
        padding: 0 10px;
        font-size: 0.85rem;
        font-weight: 500;
        color: white;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        justify-content: space-between; /* separa texto y número */
        min-width: 120px;
        height: 40px;
        border-radius: 4px;
        gap: 8px;
    }

        .estado-chip .notificacion {
            background-color: red;
            color: white;
            font-size: 0.85rem;
            font-weight: bold;
            padding: 2px 8px;
            border-radius: 50px; /* se adapta mejor a números largos */
            line-height: 1;
            min-width: 24px;
            text-align: center;
        }

    .field-label {
        font-weight: 600;
        margin-bottom: 4px;
        white-space: normal;
        word-break: break-word;
        font-size: 13px;
    }

    .field-label {
        max-width: 100%;
        display: block;
    }

</style>

