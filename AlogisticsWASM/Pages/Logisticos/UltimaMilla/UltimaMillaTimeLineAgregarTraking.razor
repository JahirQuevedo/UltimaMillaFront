@using ALOG.Modelos.Modelos.Logisticos
@using ALOGRepositorios.Services.Logisticos
@inject NavigationManager NavigationManager

@inject NotificationService notificationService

<RadzenTemplateForm Data="@TControlTerrestre" TItem="SLOTControlTerrestre" Submit="@(() => Modo == "C" ? GuardarEventualidad() : ActualizarEventualidad())">
    <RadzenFieldset Text="Agregar Eventualidad" Style="border-radius: 12px; padding: 1rem;">
        <RadzenRow>
            
            <RadzenLabel Text="Tipo de Evento" Component="DropDown" />
            <RadzenDropDown @bind-Value="objTransporteCron.IdCatTipoEventoCron"
                            Data="@listaTiposEventos"
                            TextProperty="Nombre" ValueProperty="IdCatTipoEventoCron"
                            Style="width: 100%; border-radius: 12px;" Placeholder="Seleccione un evento"
                            Name="IdCatTipoEventoCron" 
                            Disabled="@boolEditable"
                            />

            <RadzenLabel Text="Comentarios" Component="TextArea" />
            <RadzenTextArea @bind-Value="objTransporteCron.Comentarios" Name="Comentarios"
                            Style="width: 100%; border-radius: 12px;" Rows="3" MaxLength="250"
                            Disabled="boolEditable"
                            />

            @* <RadzenLabel Text="Fecha de Registro" Component="DatePicker" />
            <RadzenDatePicker @bind-Value="transporteCron.FechaRegistro" Name="FechaRegistro" Style="width: 100%;" ShowTime="true" /> *@

            @* <RadzenLabel Text="Activo" Component="CheckBox" />
            <RadzenCheckBox @bind-Value="transporteCron.Activo" Name="Activo" /> *@

            <RadzenLabel Text="Fecha del Evento" Component="DatePicker" />
            <RadzenDatePicker @bind-Value="objTransporteCron.FechaEvento" Name="FechaEvento" Style="width: 100%;" ShowTime="true"
            Disabled="@boolEditable"
            />

            <RadzenLabel Text="URL Maps" Component="TextBox" />
            <RadzenTextBox @bind-Value="objTransporteCron.URLMaps" Name="URLMaps" Style="width: 100%; border-radius: 12px;" MaxLength="250"
            Disabled="@boolEditable"
            />
            
            

            @*   <RadzenLabel Text="Usuario" Component="DropDown" />
            <RadzenDropDown @bind-Value="transporteCron.IdCatUsuarios"
                            Data="@listaUsuarios"
                            TextProperty="Nombre" ValueProperty="IdCatUsuarios"
                            Style="width: 100%;" Placeholder="Seleccione un usuario"
                            Name="IdCatUsuarios" />

            <RadzenLabel Text="Transporte Asignado" Component="DropDown" />
            <RadzenDropDown @bind-Value="transporteCron.IdSLOTransporteAsignado"
                            Data="@listaTransportes"
                            TextProperty="Descripcion" ValueProperty="IdSLOTransporteAsignado"
                            Style="width: 100%;" Placeholder="Seleccione transporte (opcional)"
                            Name="IdSLOTransporteAsignado" /> *@

            @* <div style="margin-top: 20px;">
                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Guardar" Style="margin-right:10px;" />
                <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light" Text="Cancelar" Click="@OnCancel" />
            </div> *@
           
            <RadzenUpload @ref="uploadFiles"
                          ChooseText="Agregar evidencia"
                          Multiple="true"
                          Accept=".jpg,.jpeg,.png,.pdf,image/*"
                          Auto="true"
                          Change="@OnUploadChange"
                          Style="width:40%;"
                          Disabled="@boolEditable"
                          InputAttributes="@(new Dictionary<string, object> {
                                            {"accept",".pdf, .jpg, .png"},
                                            { "aria-label", "select file" },
                                            { "title", "Seleccionar archivos PDF o imágenes (JPG, PNG)" },
                                            { "oninput", "if(this.files.length > 10){ alert('Solo puedes seleccionar hasta 6 archivos simultaneamente.'); this.value=null; }" }
                                        })" />

            
            @if (lstCargarArchivos != null && lstCargarArchivos.Any() && Modo == "C")
            {
                <RadzenDataGrid @ref="documentosGrid" TItem="SLOCargarArchivo" Data="@lstCargarArchivos"
                                ShowPagingSummary="false" AllowSorting="false" AllowFiltering="false" Responsive="true"
                                AllowPaging="false" Style="max-height:200px; overflow-y:auto; font-size:0.85rem;">
                    <Columns>
                        <RadzenDataGridColumn TItem="SLOCargarArchivo" Property="TipoDocumento" Title="Tipo" Resizable="true"/>
                        <RadzenDataGridColumn TItem="SLOCargarArchivo" Title="Archivo" Resizable="true">
                            <Template Context="doc">
                                @doc.NombreArchivo (@(doc.SizeFile / 1024) KB)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="SLOCargarArchivo" Title="Acciones" Width="80px">
                            <Template Context="doc">
                                <RadzenButton Icon="close"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.Small"
                                              Click="@(() => EliminarDocumento(doc))"/>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                                
            }
            else
            {
                @* <span style="color:gray; font-size:0.85rem;margin-top:10px;">No hay documentos cargados</span> *@
            }

            @if(Modo == "E")
            {
                <RadzenDataGrid @ref="gridArchivosIncidencias"
                                TItem="SLOSolicitudesDocumentos"
                                Data="@lstPruebasIncidencia"
                                AllowPaging="true" PageSize="4"
                                Style="border-radius:12px;">
                    <Columns>
                        <RadzenDataGridColumn Title="T. Documento">
                            <Template Context="item">@item?.catDocumentos?.Nombre</Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="N. Documento">
                            <Template Context="item">@item.NombreDocumento</Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Fecha de subida">
                            <Template Context="item">@item.FechaRegistro.ToString("dd/MM/yyyy")</Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Acciones">
                            <Template Context="item">
                                <RadzenButton Icon="visibility"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Info"
                                              Click="@(args => AbrirDocumentoCont(item))" />

                                <RadzenButton Icon="delete"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Click="@(() => BajaDocumento(item))"
                                              Visible="@(!boolEditable)"
                                               />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </RadzenRow>
        <RadzenButton Text="Editar"
                      ButtonStyle="ButtonStyle.Info"
                      Style="margin-left: 0.2rem; margin-top: 1rem; border-radius: 8px;"
                      Icon="note_add"
                      Click="HacerEditableEventualidad"
                      Visible="@(boolEditable)" />

        <RadzenButton Text="@(Modo == "C" ? "Crear" : "Actualizar")"
                      Icon="save"
                      ButtonType="ButtonType.Submit"                      
                      Style="margin-top: 1rem; background-color: #4CAF50; color: white; border-radius: 8px;"
                      Visible="@(!boolEditable)"
                      />

        <RadzenButton Text="Cerrar"
                      ButtonStyle="ButtonStyle.Danger"
                      Icon="cancel"
                      Click="OnCancel"
                      Style="margin-left: 1rem; margin-top: 1rem; border-radius: 8px;"                       
                      />        
    </RadzenFieldset>
</RadzenTemplateForm>
