                                    </RadzenDataGridColumn>
                                    <!-- Columna Tipo de Mercancía -->
                                    <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Property="IdCatMercancia" Title="Tipo de mercancia">
                                        <!-- Modo lectura -->
                                        <Template Context="item">
                                            @lstCatMercancias.FirstOrDefault(m => m.IdCatMercancia == item.IdCatMercancia)?.Nombre
                                        </Template>

                                        <!-- Modo edición -->
                                        <EditTemplate Context="item">
                                            <RadzenDropDown Placeholder="Mercancia"
                                                            Data="@lstCatMercancias"
                                                            @bind-Value="item.IdCatMercancia"
                                                            TextProperty="Nombre"
                                                            ValueProperty="IdCatMercancia"
                                                            Style="border-radius:12px;"
                                                            Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>


                                    <!-- Columna Acciones -->
                                    <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Context="item" Width="80px" Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)">
                                        <Template Context="item">
                                            <RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(() => EditarDetalle(item))" Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)" />
                                            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                          Click="@(() => EliminarDetalle(item))"
                                                          Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)" />
                                        </Template>
                                        <EditTemplate Context="item">
                                            <RadzenButton Icon="save" Size="ButtonSize.Small" ButtonType="ButtonType.Submit"
                                                          Click="@(async () => { await AgregarDetalle(item); await gridSolicitudesDetalle.UpdateRow(item); })"
                                                          Disabled="@(!gridSolicitudesDetalle.IsValid)" />
                                            <RadzenButton Icon="cancel" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                                                          Click="@(() => CancelarEdicion(item))"
                                                          Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>


                            <!-- Botón para guardar todos los detalles -->
                            @* <div style="margin-top: 20px; text-align: right;">
				<RadzenButton Text="Guardar Todo" Click="@GuardarTodosDetalles" ButtonStyle="ButtonStyle.Success" />
			</div> *@
                        </div>

                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Contenerizada" Disabled="@(acronimoTipoCargaSeleccionado != "CONT")">
                        <div @key="selectedTabIndex">

                            <div style="padding: 20px; text-align: center;">
                                <RadzenIcon Icon="build" Style="font-size: 40px; color: #007ACC;" />
                                <h3>Estamos trabajando en esta sección 🚧</h3>
                                <p>La funcionalidad para este tipo de carga está en desarrollo y será integrada próximamente.</p>
                                <p>Gracias por tu paciencia mientras seguimos mejorando el servicio logístico.</p>
                            </div>
                        </div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="General" Disabled="@(acronimoTipoCargaSeleccionado != "GEN")">
                        <div @key="selectedTabIndex">

                            <div style="padding: 20px; text-align: center;">
                                <RadzenIcon Icon="build" Style="font-size: 40px; color: #007ACC;" />
                                <h3>Estamos trabajando en esta sección 🚧</h3>
                                <p>La funcionalidad para este tipo de carga está en desarrollo y será integrada próximamente.</p>
                                <p>Gracias por tu paciencia mientras seguimos mejorando el servicio logístico.</p>
                            </div>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="En desarrollo" Disabled="@(!(acronimoTipoCargaSeleccionado != "GEN") || !(acronimoTipoCargaSeleccionado != "CONT") || !(acronimoTipoCargaSeleccionado != "PAL"))">
                        <div style="padding: 20px; text-align: center;">
                            <RadzenIcon Icon="build" Style="font-size: 40px; color: #007ACC;" />
                            <h3>Estamos trabajando en esta sección 🚧</h3>
                            <p>La funcionalidad para este tipo de carga está en desarrollo y será integrada próximamente.</p>
                            <p>Gracias por tu paciencia mientras seguimos mejorando el servicio logístico.</p>
                        </div>
                    </RadzenTabsItem>
                }
                
            </Tabs>
        </RadzenTabs>

<!-- Botones arriba a la derecha -->
<div style="display:flex; gap:0.5rem; justify-content:flex-end; margin:0.5rem 2.5rem 1rem 0;">
    <RadzenButton Icon="add_circle"
                  Text="@(Modo == "C" ? "Crear" : "Actualizar")"
                  ButtonStyle="ButtonStyle.Secondary"
                  ButtonType="ButtonType.Button"
                  Style="border-radius: 8px;"
                  Click="@(async () =>
                         {
                             if (Modo == "C")
                                 await GenerarSolicitud();
                             else if(Modo == "E")
                                 await ActualizarSolicitud(objSLOSolicitudes);
                         })"
                          Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)" />

    <RadzenButton Icon="cancel"
                  Text="Cerrar"
                  ButtonStyle="ButtonStyle.Primary"
                  Style="border-radius: 8px;"
                  Click="@CerrarModal"/>
</div>

</RadzenFieldset>
</div>