                                    @* <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Title="N°" Width="30px">
                            <Template Context="item">
                                @(Items.IndexOf(item) >= 0 ? Items.IndexOf(item) + 1 : "-")
                            </Template>
                        </RadzenDataGridColumn> *@

                                    <!-- Columna Tipo de Mercancía -->
                                    <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Property="IdCatMercancia" Title="Tipo de mercancia">
                                        <!-- Modo lectura -->
                                        <Template Context="item">
                                            @lstCatMercancias.FirstOrDefault(m => m.IdCatMercancia == item.IdCatMercancia)?.Nombre
                                        </Template>

                                        <!-- Modo edición -->
                                        <EditTemplate Context="item">
                                            <RadzenDropDown Placeholder="Mercancia"
                                                            Data="@lstCatMercancias"
                                                            @bind-Value="item.IdCatMercancia"
                                                            TextProperty="Nombre"
                                                            ValueProperty="IdCatMercancia"
                                                            Style="border-radius:12px;width:120px; height:30px; font-size:15px; padding:2px 6px;"
                                                            Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>
                                    <!-- Columna Mercancía Peligrosa -->
                                    <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Property="MciaPeligrosa" Width="40px">
                                        <HeaderTemplate>
                                            <span title="Mercancía Peligrosa">M.P.</span>
                                        </HeaderTemplate>
                                        <Template Context="item">
                                            <RadzenCheckBox Value="item.MciaPeligrosa" Disabled />
                                        </Template>
                                        <EditTemplate Context="item">
                                            <RadzenCheckBox @bind-Value="item.MciaPeligrosa" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Title="T. IMO">
                                        <!-- Modo solo lectura -->
                                        <Template Context="item">
                                            @if (item.MciaPeligrosa && item.IdCatTipoImo != null)
                                            {
                                                var tipoIMO = lstCatTipoIMO.FirstOrDefault(x => x.IdCatTipoIMO == item.IdCatTipoImo);
                                                <span>@(tipoIMO?.Nombre ?? "No definido")</span>
                                            }
                                            else
                                            {
                                                <span style="color: #999;">No aplica</span>
                                            }
                                        </Template>

                                        <!-- Modo edición -->
                                        <EditTemplate Context="item">
                                            @if (item.MciaPeligrosa)
                                            {
                                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                                    <RadzenDropDown Data="@lstCatTipoIMO"
                                                                    @bind-Value="item.IdCatTipoImo"
                                                                    TextProperty="Nombre"
                                                                    ValueProperty="IdCatTipoIMO"
                                                                    Placeholder="Selecciona tipo IMO"
                                                                    Style="width:100%; border-radius: 12px;" />
                                                </div>
                                            }
                                            else
                                            {
                                                <span style="color: #999;">No aplica</span>
                                            }
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Property="NoParte" Title="NoParte">
                                        <EditTemplate Context="item">
                                            <RadzenTextBox @bind-Value="item.NoParte"
                                                           Style="width:100%; border-radius:12px;" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <!-- Columna Cantidad -->
                                    <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Property="Cantidad" Title="Cantidad Pallets">
                                        <EditTemplate Context="item">
                                            <RadzenNumeric TValue="int?" @bind-Value="item.Cantidad"
                                                           Style="width:100%; border-radius:12px;"
                                                           Min="0" ShowUpDown="false" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <!-- Columna Piezas -->
                                    <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Property="Piezas" Title="Cantidad de Piezas">
                                        <EditTemplate Context="item">
                                            <RadzenNumeric TValue="int?" @bind-Value="item.Piezas"
                                                           Style="width:100%; border-radius:12px;"
                                                           Min="0" ShowUpDown="false" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <!-- Columna Peso -->
                                    <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Property="Peso" Title="Peso">
                                        <EditTemplate Context="item">
                                            <RadzenNumeric TValue="decimal?" @bind-Value="item.Peso"
                                                           Style="width:100%;border-radius:12px;"
                                                           Min="0" ShowUpDown="false"
                                                           InputAttributes="@(new Dictionary<string, object>{
                                                                          { "onkeypress", "if(event.key === ','){event.preventDefault();}" }
                                                                      })" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>

                                    <!--Columna Tipo Volumen-->
                                    <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Property="Volumen" Title="Volumen m^3">
                                        <EditTemplate Context="item">
                                            <RadzenNumeric TValue="decimal?" @bind-Value="item.Volumen"
                                                           Style="width:100%;border-radius:12px;"
                                                           Min="0" ShowUpDown="false" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>                                    

                                    <!-- Columna Acciones -->
                                    <RadzenDataGridColumn TItem="SLOSolicitudesDetalle" Context="item" Width="80px" Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)">
                                        <Template Context="item">
                                            <RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(() => EditarDetalle(item))" Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)" Style="border-radius: 5px;"/>
                                            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
                                                          Click="@(() => EliminarDetalle(item))"
                                                          Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)" Style="border-radius: 5px;" />
                                        </Template>
                                        <EditTemplate Context="item">
                                            <RadzenButton Icon="save" Size="ButtonSize.Small" ButtonType="ButtonType.Submit"
                                                          Click="@(async () => { await AgregarDetalle(item); await gridSolicitudesDetalle.UpdateRow(item); })"
                                                          Disabled="@(!gridSolicitudesDetalle.IsValid)" Style="border-radius: 5px;" />
                                            <RadzenButton Icon="cancel" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary"
                                                          Click="@(() => CancelarEdicion(item))"
                                                          Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)" Style="border-radius: 5px;" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>


                            <!-- Botón para guardar todos los detalles -->
                            @* <div style="margin-top: 20px; text-align: right;">
				<RadzenButton Text="Guardar Todo" Click="@GuardarTodosDetalles" ButtonStyle="ButtonStyle.Success" />
			</div> *@
                        </div>

                    </RadzenTabsItem>

                    <RadzenTabsItem Text="Contenerizada" Disabled="@(acronimoTipoCargaSeleccionado != "CONT")">
                        <div @key="selectedTabIndex">

                            <div style="padding: 20px; text-align: center;">
                                <RadzenIcon Icon="build" Style="font-size: 40px; color: #007ACC;" />
                                <h3>Estamos trabajando en esta sección 🚧</h3>
                                <p>La funcionalidad para este tipo de carga está en desarrollo y será integrada próximamente.</p>
                                <p>Gracias por tu paciencia mientras seguimos mejorando el servicio logístico.</p>
                            </div>
                        </div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="General" Disabled="@(acronimoTipoCargaSeleccionado != "GEN")">
                        <div @key="selectedTabIndex">

                            <div style="padding: 20px; text-align: center;">
                                <RadzenIcon Icon="build" Style="font-size: 40px; color: #007ACC;" />
                                <h3>Estamos trabajando en esta sección 🚧</h3>
                                <p>La funcionalidad para este tipo de carga está en desarrollo y será integrada próximamente.</p>
                                <p>Gracias por tu paciencia mientras seguimos mejorando el servicio logístico.</p>
                            </div>
                        </div>
                    </RadzenTabsItem>

                    <RadzenTabsItem Text="En desarrollo" Disabled="@(!(acronimoTipoCargaSeleccionado != "GEN") || !(acronimoTipoCargaSeleccionado != "CONT") || !(acronimoTipoCargaSeleccionado != "PAL"))">
                        <div style="padding: 20px; text-align: center;">
                            <RadzenIcon Icon="build" Style="font-size: 40px; color: #007ACC;" />
                            <h3>Estamos trabajando en esta sección 🚧</h3>
                            <p>La funcionalidad para este tipo de carga está en desarrollo y será integrada próximamente.</p>
                            <p>Gracias por tu paciencia mientras seguimos mejorando el servicio logístico.</p>
                        </div>
                    </RadzenTabsItem>
                }
                
            </Tabs>
        </RadzenTabs>

<!-- Botones arriba a la derecha -->
<div style="display:flex; gap:0.5rem; justify-content:flex-end; margin:0.5rem 2.5rem 1rem 0;">
    <RadzenButton Icon="add_circle"
                  Text="@(Modo == "C" ? "Crear" : "Actualizar")"
                  ButtonStyle="ButtonStyle.Secondary"
                  ButtonType="ButtonType.Button"
                  Style="border-radius: 8px;"
                  Click="@(async () =>
                         {
                             if (Modo == "C")
                                 await GenerarSolicitud();
                             else if(Modo == "E")
                                 await ActualizarSolicitud(objSLOSolicitudes);
                         })"
                          Visible="@(Modo == "C" || Modo == "E" && objSLOSolicitudes.IdCatTipoEstado == 1)" />

    <RadzenButton Icon="cancel"
                  Text="Cerrar"
                  ButtonStyle="ButtonStyle.Primary"
                  Style="border-radius: 8px;"
                  Click="@CerrarModal"/>
</div>

</RadzenFieldset>
</div>