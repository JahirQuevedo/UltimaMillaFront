@using ALOG.Modelos.Modelos.Logisticos;
@using ALOG.Modelos.Modelos.Catalogos;
@using System.Globalization;

@inject Radzen.DialogService DialogService;


<style>

    .display-zoom {
        
    }

    .ubicacion-grid-min {
        display: grid;
        grid-template-columns: 1fr 1fr; /* dos columnas */
        gap: 0.5rem 1rem; /* espacio entre bloques */
        font-size: 0.85rem; /* fuente más pequeña */
    }

        .ubicacion-grid-min div {
            display: grid;
            grid-template-columns: max-content 1fr; /* etiqueta + valor dentro del bloque */
            column-gap: 0.5rem;
            align-items: start;
        }

        .ubicacion-grid-min dt,
        .ubicacion-grid-min dd {
            margin: 0;
            padding: 0;
        }


	:root {
	--rz-grid-header-color: white;
	--rz-grid-header-background-color: darkred;
	}

	.rz-datepicker-custom .rz-inputtext,
	.rz-datepicker-custom .rz-datepicker {
	border-radius: 8px !important;
	}

	/* Letras negras en pestañas inactivas */
	.rz-tabview-nav li a {
	color: black !important;
	border-radius: 8px; /* Bordes redondeados */
	padding: 8px 16px;
	}

	/* Fondo amarillo opaco en pestaña activa */
	.rz-tabview-nav li.rz-state-active a {
	background-color: rgba(255, 204, 0, 0.3); /* Amarillo opaco */
	color: black !important;
	}

	/* Opcional: quita el borde inferior que separa las pestañas del contenido */
	.rz-tabview-nav {
	border-bottom: none;
	}

    /* ------------- “Chips” de Estado ------------- */
    .status-chip {
        display: inline-block;
        padding: 4px 8px;
        padding-top: 2rem;
        margin-top: -2rem;
        border-radius: 4px;
        font-size: 1.5rem;
        text-align: center;
        min-width: 100px;
    }

    /* ABIERTO */
    .status-1 {
        background-color: #000000; /* negro */
        color: white;
    }

    /* EN PROCESO */
    .status-2 {
        background-color: #ffb425; /* naranja */
        color: black;
    }

    /* TERMINADO */
    .status-3 {
        background-color: #4caf50; /* verde */
        color: white;
    }

    /* CANCELADO */
    .status-4 {
        background-color: #f44336; /* rojo */
        color: white;
    }

    /* PENDIENTE */
    .status-5 {
        background-color: #9e9e9e; /* gris medio */
        color: white;
    }


    .chips-container {
        display: flex;
        gap: 0.25rem; /* Reducido para que estén casi pegadas */
        justify-content: flex-end;
        /* min-height: 50px; */
        /* margin-bottom: 0.5rem;
            padding-right: 1rem; */
    }

    .estado-chip {
        background-color: gray;
        padding: 0 10px;
        font-size: 0.85rem;
        font-weight: 500;
        color: white;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        justify-content: space-between; /* separa texto y número */
        min-width: 120px;
        height: 40px;
        border-radius: 4px;
        gap: 8px;
    }

</style>

