            <RadzenFieldset Text="Transporte Asignado" Style="margin-top: 2rem; min-height: 220px;" class="@zoomType">
                <RadzenRow Gutter="16">
                    <!-- Placas -->
                    @* <RadzenColumn Size="2">
                        <RadzenLabel Text="Placas"/>
                    <RadzenTextBox @bind-Value="objTransporteAsignado.Placas" Style="width: 100%; text-transform: uppercase;" Disabled="@(Modo == "R")"
                        MaxLength="10"
                                   />
                                   <RadzenRegexValidator/>
                    </RadzenColumn> *@
                <!-- Placas -->
                <RadzenColumn Size="2">
                    <RadzenLabel Text="Placas" />

                    <RadzenTextBox @bind-Value="objTransporteAsignado.Placas"                                   
                                   Style="width: 100%; text-transform: uppercase;"
                                   Disabled="@(Modo == "R")"
                                   MaxLength="10"
                                   Name="Placas"
                                   />

                    @* <RadzenRegexValidator Component="Placas"
                                          Pattern="^[A-Z0-9-]*$"
                                          Text="Solo se permiten letras mayúsculas, números y guion."
                                          Style="position: relative; display: block;"
                                          Popup="true" /> *@
                </RadzenColumn>



                    <!-- Económico -->
                    <RadzenColumn Size="2">
                        <RadzenLabel Text="Económico"/>
                        <RadzenTextBox @bind-Value="objTransporteAsignado.Economico" Style="width: 100%;" Disabled="@(Modo == "R")"
                        MaxLength="10"
                        />
                    </RadzenColumn>

                    <!-- Color -->
                    <RadzenColumn Size="2">
                        <RadzenLabel Text="Color"/>
                        <RadzenTextBox @bind-Value="objTransporteAsignado.Color" Style="width: 100%;" Disabled="@(Modo == "R")"
                        MaxLength="20"
                        />
                    </RadzenColumn>

                    <!-- Conductor -->
                    <RadzenColumn Size="3">
                        <RadzenLabel Text="Conductor"/>
                        <RadzenTextBox @bind-Value="objTransporteAsignado.Operador" Style="width: 100%;" Disabled="@(Modo == "R")"
                        MaxLength="150"/>
                    </RadzenColumn>

                 

                    @*    <!-- Celular -->
                    <RadzenColumn Size="3">
                        <RadzenLabel Text="Celular" />
                        <RadzenTextBox @bind-Value="objTransporteAsignado" Style="width: 100%;" />
                    </RadzenColumn> *@
                </RadzenRow>






                <RadzenRow Gutter="16" Class="mt-3">
                   @*  <RadzenColumn Size="3">
                        <RadzenText Text="Marca"/>
                    <RadzenTextBox @bind-Value="objTransporteAsignado.Marca" Style="margin-left: 0.5rem" Disabled="@(Modo == "R")" />
                    </RadzenColumn> *@
                   <!--Marca-->
                       <RadzenColumn Size="3">
                        <RadzenLabel Text="Marca" />
                    <RadzenTextBox @bind-Value="objTransporteAsignado.Marca" Style="width: 100%;" Disabled="@(Modo == "R")" 
                    MaxLength="50"
                    />
                    </RadzenColumn>

                    <!-- CAAT -->
                    <RadzenColumn Size="3">
                        <RadzenLabel Text="CAAT"/>
                        @* <RadzenTextBox @bind-Value="caat"  /> *@
                        <RadzenTextBox @bind-Value="objSLOTransporteSolicitud.CAAT"
                                       Name="CAAT"
                                       Style="width: 100%; text-transform: uppercase;"
                                       MaxLength="50" Disabled="@(Modo == "R")"                                       
                                       />
                                       
                        <RadzenRequiredValidator Component="CAAT"
                                                 Text="El CAAT es requerido"
                                                 Style="margin-left: 0.5rem" Disabled="@(Modo == "R")"/>

                        <RadzenRegexValidator Component="CAAT"
                                              Pattern="^[A-Z0-9]{10}$"
                                              Text="Debe contener exactamente 10 caracteres alfanuméricos en mayúsculas"
                                              Style="margin-left: 0.5rem" Disabled="@(Modo == "R")"/>
                    </RadzenColumn>

                    <!-- FOLIO UUID -->
                    <RadzenColumn Size="3"> <!-- aumenté el tamaño -->
                        <RadzenLabel Text="FOLIO UUID"/>
                        <RadzenTextBox @bind-Value="objSLOTransporteDetalle.FolioUUID"
                                       MaxLength="50"
                                       Style="width: 100%;"
                                       Disabled="@(Modo == "R")"/>
                    </RadzenColumn>

                    <!--XCarga de documentos-->
                   
                </RadzenRow>
                <RadzenRow Style="margin-top:1rem;">
                    <RadzenColumn Size="6">
                        @* <RadzenButton Icon="add" Text="Agregar documento" Click="@AgregarDocumento" Style="margin-bottom:1rem" /> *@
                        @* <RadzenUpload ChooseText="Seleccionar documentos"
                                      Multiple="true"
                                      Accept="application/pdf"
                                      Auto="false"
                                      Change="@OnUploadChange"
                                      Style="width:100%;" />   *@

                        <RadzenUpload @ref="uploadFiles"
                            ChooseText="Agregar documentos"
                                      Multiple="true"
                                      Accept=".pdf,application/pdf"
                                      Auto="true"
                                      
                                      Change="@OnUploadChange"                                      
                                      Style="width:40%;"
                                  InputAttributes="@(new Dictionary<string, object> {
                                                    { "accept", ".pdf" },
                                                    { "title", "Seleccionar archivos PDF" },
                                                    { "oninput", "if(this.files.length > 10){ alert('Solo puedes seleccionar hasta 6 archivos PDF.'); this.value=null; }" }
                                                })"
                                      Visible="@(Modo == "C")"
                                      @key="uploadKey"
                                      />   <!-- <‑‑ aquí -->


                        @if (lstCargarArchivos != null && lstCargarArchivos.Any())
                        {
                                    <RadzenDataGrid @ref="documentosGrid" TItem="SLOCargarArchivo" Data="@lstCargarArchivos"
                                                    ShowPagingSummary="false" AllowSorting="false" AllowFiltering="false" Responsive="true"
                                                    AllowPaging="false" Style="max-height:200px; overflow-y:auto; font-size:0.85rem;">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="SLOCargarArchivo" Property="TipoDocumento" Title="Tipo" Resizable="true"/>
                                            <RadzenDataGridColumn TItem="SLOCargarArchivo" Title="Archivo" Resizable="true">
                                                <Template Context="doc">
                                                    @doc.NombreArchivo (@(doc.SizeFile / 1024) KB)
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="SLOCargarArchivo" Title="Acciones" Width="80px">
                                                <Template Context="doc">
                                                    <RadzenButton Icon="close"
                                                                  ButtonStyle="ButtonStyle.Danger"
                                                                  Size="ButtonSize.Small"
                                                                  Click="@(() => EliminarDocumento(doc))"/>
                                                </Template>
                                            </RadzenDataGridColumn>
                                        </Columns>
                                    </RadzenDataGrid>
                                
                        }
                        else
                        {
                            @* <span style="color:gray; font-size:0.85rem;margin-top:10px;">No hay documentos cargados</span> *@
                        }


                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>

            <!-- Botones flotantes -->
            <RadzenButton Icon="add_circle" Text="Crear"
                          ButtonStyle="ButtonStyle.Secondary"
                          Click="@(() => CrearSolicitudTransporte())"
                          Style="border-radius: 8px; min-width: 120px; margin-top: 20px;" Visible="@(Modo == "C")" class="@zoomType"/>

            <RadzenButton Icon="cancel" Text="Cancelar"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => DialogService.Close(null))"
                          Style="border-radius: 8px; min-width: 120px; margin-top: 20px;" Visible="@(Modo == "C")" class="@zoomType"/>
            <RadzenButton Icon="cancel" Text="Cerrar"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@(() => DialogService.Close(null))"
                          Style="border-radius: 8px; min-width: 120px; margin-top: 20px;" Visible="@(Modo == "R")" class="@zoomType"/>


        </div>
    </div>


