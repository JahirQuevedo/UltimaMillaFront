                                    Disabled="@(Modo == "R")" />

                   @* <h5 style="margin-top: 0.9rem; margin-left: 3.0rem;">Transporte Terrestre</h5> *@
                <RadzenFieldset Text="Lugar de entrega (Destino)" Style="min-height: 220px;">
                    <RadzenRow>
                        <!-- Columna 1: Fecha -->
                        <RadzenColumn Size="3">
                            <RadzenFieldset>
                                <div style="text-align: center;">
                                    <h7><strong>@Solicitud.FechaFin?.ToString("dd/MM/yyyy")</strong></h7>
                                        <h7><strong>@objSolicitudes.FechaFin?.ToString("HH:mm") </strong>hrs.</h7>
                                </div>
