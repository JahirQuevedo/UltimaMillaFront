@page "/ultima-milla-tran"
@inject Radzen.DialogService DialogService
@inject IJSRuntime JS 
@using ALOG.Modelos.Modelos.Logisticos;
@using ALOGRepositorios.Services.Logisticos
@using Radzen;
<style>
    .display-zoom {
        zoom: 0.75;
    }

    :root {
    --rz-grid-header-color: white;
    --rz-grid-header-background-color: darkred;
    }

    .rz-datepicker-custom .rz-inputtext,
    .rz-datepicker-custom .rz-datepicker {
    border-radius: 8px !important;
    }

    .rz-tabview-nav li a {
    color: black !important;
    border-radius: 8px;
    padding: 8px 16px;
    }

    .rz-tabview-nav li.rz-state-active a {
    background-color: rgba(255, 204, 0, 0.3);
    color: black !important;
    }

    .rz-tabview-nav {
    border-bottom: none;
    }
    /* Oculta solo la lista de archivos seleccionados */
    .hide-upload-list .rz-upload-file-list {
        display: none !important; /* !important evita que la librería lo sobreescriba */
    }

</style>


