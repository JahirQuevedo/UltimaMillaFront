    @if (Modo == "C")
    {
        <RadzenText Text="Contenido a cargar" 
                    Style="display:block; font-size:1.3rem; font-weight:600; 
                       color:#b22222; margin: 1rem 0; border-bottom:2px solid #ccc; padding-bottom:4px;" />
    }
    else if (Modo == "R")
    {
        <RadzenText Text="Contenido de la carga" 
                    Style="display:block; font-size:1.3rem; font-weight:600; 
                       color:#2f4f4f; margin: 1rem 0; border-bottom:2px solid #ccc; padding-bottom:4px;" />
    }


        <RadzenDataGrid Data="@lstCargamentoDto" TItem="CargamentoDTO" @ref="gridDetalles" Style="border-radius: 12px;">
            <Columns>
                @if (Modo == "C")
                {
                    <RadzenDataGridColumn TItem="CargamentoDTO" Title="Seleccionar">
                        <Template Context="item">
                            <RadzenCheckBox TValue="bool"
                                            Value="@IsSelected(item.SolicitudesDet)"
                                            Change="@(args => OnSelectChanged(item.SolicitudesDet, args))"/>
                        </Template>
                    </RadzenDataGridColumn>
                }
                
                <RadzenDataGridColumn TItem="CargamentoDTO" Title="Tipo de Mercancía">
                    <Template Context="item">
                        @item.SolicitudesDet.catTipoMercancia?.Nombre
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CargamentoDTO" Property="SolicitudesDet.NoParte" Title="Número de Parte"/>
                <RadzenDataGridColumn TItem="CargamentoDTO" Property="SolicitudesDet.Cantidad" Title="Cantidad Pallets"/>
                <RadzenDataGridColumn TItem="CargamentoDTO" Property="SolicitudesDet.Piezas" Title="Cantidad"/>
                <RadzenDataGridColumn TItem="CargamentoDTO" Property="SolicitudesDet.Peso" Title="Peso"/>
                <RadzenDataGridColumn TItem="CargamentoDTO" Property="SolicitudesDet.Volumen" Title="Volumen" />
            </Columns>
        </RadzenDataGrid>
        
        </RadzenFieldset>

    
