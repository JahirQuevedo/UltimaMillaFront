else @if (_datosExcel?.Any() == true)
{            
    <div class="tabla-scroll-wrapper">
        <RadzenDataGrid @ref="gridDatos" Data="_datosExcel" TItem="Dictionary<string, string>"
        AllowMultiColumnSorting="true" PageSize="6"
        ShowMultiColumnSortingIndex="true" AllowPaging="true" 
        AllowSorting="true" ColumnWidth="300px"
        Editable="true" EditMode="DataGridEditMode.Single"
        RowUpdate="@GuardarRegistroNuevo" RowCancel="@CancelarEdicion"
        ShowPagingSummary="true" class="rz-datatable-table">
            <Columns>
                @foreach (var columna in _columnas.Where(c => c != "Referencia alo" && c != "Clave" && c != "Comentario encabezado" && c != "Comentario partida"))
                {
                    <RadzenDataGridColumn TItem="Dictionary<string, string>" Property="@columna" Title="@columna">
                        <Template Context="dato">
                            <div style=" white-space: nowrap;">
                                @(dato.TryGetValue(columna, out var valor) && !string.IsNullOrWhiteSpace(valor) && valor != "N/A" ? valor : string.Empty)
                            </div>
                        </Template>
                        <EditTemplate Context="dato">
                            @* <RadzenTextBox Value="@dato[columna]"
                            ValueChanged="@(v => dato[columna] = v)"
                            Style="width: 100%;" /> *@
                            @if (columna == "Cantidad" || columna == "Subtotal")
                            {
                                <RadzenNumeric TValue="decimal"
                                               Value="@(decimal.TryParse(dato[columna], out var val) ? val : 0)"
                                               ValueChanged="@(v => dato[columna] = v.ToString())"
                                               Style="width: 100%;" />
                            }
                            else if (columna == "Cliente factura")
                            {
                                <RadzenAutoComplete TValue="RespListarCoincidenciasDTO"                                                    
                                                    Data="@respListarCoincidencias"
                                                    TextProperty="RazonSocial"
                                                    ValueProperty="RazonSocial"
                                                    Placeholder="Buscar cliente"
                                                    Style="width:100%"
                                                    Change="@(args => OnClientefactSeleccionado(args, dato))"
                                                    LoadData="AutoCompleteOnLoadCliente" />
                            }
                            else if (columna == "Servicio")
                            {
                                <RadzenAutoComplete TValue="CatServicios"
                                                    Data="@serviciosDisponibles"
                                                    TextProperty="Nombre"
                                                    ValueProperty="Nombre"
                                                    Placeholder="Buscar servicio"
                                                    Style="width:100%"
                                                    Change="@(args => OnServicioSeleccionado(args, dato))"
                                                    LoadData="AutoCompleteOnLoadServicio" />
                            }
                            else
                            {
                                <RadzenTextBox Value="@dato[columna]"
                                               ValueChanged="@(v => dato[columna] = v)"
                                               Style="width: 100%;" />
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>
                }

                <RadzenDataGridColumn TItem="Dictionary<string, string>" Title="" Width="150px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                    <Template Context="dato">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" title="Editar"
                                      Click="@(args => EditarRegistro(dato))" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" title="Eliminar"
                        Click="() => EliminarRegistro(dato)" />
                    </Template>
                    <EditTemplate Context="dato">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" title="Aceptar"
                        Click="@(args => gridDatos.UpdateRow(dato))" />
                        <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" title="Cancelar"
                                      Click="@(args => CancelarEdicion(dato))" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
    <RadzenButton Text="Guardar" Icon="save" Click="GuardarRegistrosAsync" Style="margin-top: 4px; margin-right: 3px;" ButtonStyle="ButtonStyle.Primary" Disabled="@(!_datosExcel?.Any() ?? true)" /> @* Click="GuardarRegistrosAsync" *@
    @if (!mostrarServiciosLigados && (_datosExcel?.Any() ?? false))
    {
        <RadzenButton Icon="arrow_back" Text="Cancelar" ButtonStyle="ButtonStyle.Secondary"
                      Click="@(() => CancelarCarga())" />
    }
}
else
{
    <p><i>No hay datos cargados.</i></p>
}


