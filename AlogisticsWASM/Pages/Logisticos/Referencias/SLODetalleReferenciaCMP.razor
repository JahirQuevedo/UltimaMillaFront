@using ALOG.Modelos.Modelos.Orden
@using ALOG.Modelos.Modelos.Logisticos
@using AlogisticsWASM.Layout.Utilerias
@using ALOG.Modelos.Modelos.DTO.Respuestas

@inject IJSRuntime js
@inject NotificationService NotificationService
@inject DialogService DialogService


<style>
    .tabla-scroll-wrapper {
    max-height: 500px;
    overflow-x: auto;
    overflow-y: auto;
    border: 1px solid #dcdcdc;
    }

    /* Aplica ancho automático a la tabla */
    .tabla-scroll-wrapper .rz-datatable-table {
    width: auto !important;
    min-width: 100% !important;
    table-layout: auto !important;
    }

    /* Evita truncamiento de texto */
    .tabla-scroll-wrapper .rz-datatable-data td {
    white-space: nowrap !important;
    }

    .tabla-scroll-wrapper .rz-header-cell {
    white-space: nowrap !important;
    }
</style>

<style>
    .centrar {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    user-select: none;
    white-space: nowrap;
    }

    #ddUpload {
    left: 0;
    --rz-upload-button-bar-background-color: transparent;
    --rz-upload-button-bar-padding: 0;
    }

    #ddUpload .rz-fileupload-buttonbar .rz-fileupload-choose {
    width: 100%;
    text-align: center;
    font-size: 16px;
    padding: 100px 0;
    }
</style>

<BarraInformacion Datos="@DiccionarioInfoReferencias"/>

<label for="inputExcel" class="rz-button rz-button-md rz-button-secondary" style="margin-top: 10px; background-color: midnightblue">
    <i class="rz-button-icon-left pi pi-upload"></i> Cargar Plantilla
</label>
<InputFile id="inputExcel" OnChange="SubirYProcesarArchivo" style="display: none;"/>

<RadzenButton Icon="add_circle" Text="Agregar Servicio" Click="@AgregarNuevoRegistro" Style="margin-top: 10px;"
              ButtonStyle="ButtonStyle.Secondary" /> @* Style="margin-bottom:2px; width: 30%;" *@
<RadzenButton Icon="fact_check" Text="Enviar a Facturar"
              ButtonStyle="ButtonStyle.Light"
              Click="@AbrirModalFacturacion"
              Disabled="@(!serviciosSeleccionados?.Any() ?? true)" />


@if (_isLoading)
{
    <div class="rz-my-auto rz-mx-auto rz-p-4 rz-p-md-12 centrar" style="max-width: 600px;">
        <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" ProgressBarStyle="ProgressBarStyle.Primary">
            <Template>Cargando</Template>
        </RadzenProgressBarCircular>
    </div>
}
