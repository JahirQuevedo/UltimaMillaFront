    private async Task BurcarInventarioAlmacen()
    {
        await ObtenerDatos(_args);

    }

    private async Task ObtenerDatos(LoadDataArgs args) 
    {

        isLoading = true;

        ////Console.WriteLine("-> Obtener Datos args : " + JsonSerializer.Serialize(args));

         ConsultaCatalogoBase<ConsultaMonitorInventario> _consultaInventario = new ConsultaCatalogoBase<ConsultaMonitorInventario>();
        _consultaInventario.Entidad = new ConsultaMonitorInventario();

        if (args != null) {
            numeroDePagina = ((int)args.Skip/registrosPorPagina) + 1;
        }

        //TODO: Se asigna el identificador del Cliente que se encuentra en la sesión
        //_consultaInventario.Entidad.IdCatCliente = 5;
        _consultaInventario.Entidad.TipoFecha = valTipoFecha;
        _consultaInventario.Entidad.BuscarPorConsultaInventario = (BuscarPorConsultaInventario)valBuscarPor;
        _consultaInventario.Entidad.ValorBusqueda = _consultaMonitorInventario.ValorBusqueda;
        _consultaInventario.Entidad.FechaInicio = _consultaMonitorInventario.FechaInicio;
        _consultaInventario.Entidad.FechaFin = _consultaMonitorInventario.FechaFin;

        _consultaInventario.Entidad.ListaIdCatCliente = new List<int>();
        _consultaInventario.Entidad.ListaIdCatCliente.Add(5);
         _consultaInventario.Entidad.ListaIdCatCliente.Add(21);
        _consultaInventario.NumeroDePagina = numeroDePagina;
        _consultaInventario.RegistrosPorPagina = registrosPorPagina;

        InvokeAsync(async () =>
        {

            var _result = await _inventarioAlmacenService.ObtenerListaPaginada(_consultaInventario);
            
            if (_result.Success) {

                listaMonitorInventarioAlmacen = _result.Data;

                totalRegistros = (int)_result.Paginado.TotalRegistros;

            }

            isLoading = false;

            selectedInventarioAlmacen = null;

            DialogService.Close();

            await InvokeAsync(StateHasChanged);

            });

        await BusyDialog("Cargando Información...");

        

    }

    private void OnSelectionChanged(object value) {
        _consultaMonitorInventario.ValorBusqueda = String.Empty;
        StateHasChanged();
    }

    async void OnExportarReporteInventario() {

        InvokeAsync(async () =>
        {

            ConsultaMonitorInventario _consultaInventario = new ConsultaMonitorInventario();

            //TODO: Se asigna el identificador del Cliente que se encuentra en la sesión
            //_consultaInventario.Entidad.IdCatCliente = 5;
            _consultaInventario.TipoFecha = valTipoFecha;
            _consultaInventario.BuscarPorConsultaInventario = (BuscarPorConsultaInventario)valBuscarPor;
            _consultaInventario.ValorBusqueda = _consultaMonitorInventario.ValorBusqueda;
            _consultaInventario.FechaInicio = _consultaMonitorInventario.FechaInicio;
            _consultaInventario.FechaFin = _consultaMonitorInventario.FechaFin;

            _consultaInventario.ListaIdCatCliente = new List<int>();
            _consultaInventario.ListaIdCatCliente.Add(5);
            _consultaInventario.ListaIdCatCliente.Add(21);
            var _result = await _reporteInventarioService.ObtieneReporteDescargaInventario(_consultaInventario);

            if (_result.Success) {

                await JSRuntime.InvokeVoidAsync("AbrirArchivoArregloByte", _result.Data.Archivo,  _result.Data.ContentType, Convert.ToBase64String(_result.Data.Content));

            }

            BusyDialogService.Close();

            await ObtenerDatos(_args);

            await InvokeAsync(StateHasChanged);

        });

        await BusyDialog("Generando Reporte Inventario Terminal...");

    }

    async void DescargaExpedienteExcel()
    {
        //Console.WriteLine("-> DescargaExpedienteExcel");
        string _pathOrdenServicio = String.Empty;

        int _idOrdenServicio = 0;

        try {

            MultipleSeleccionArchivoBase multipleSeleccionArchivoBase = new MultipleSeleccionArchivoBase();
            multipleSeleccionArchivoBase.ArchivoBase = new ArchivoBase();
            multipleSeleccionArchivoBase.Ids = new List<int>();

            foreach(var item in selectedInventarioAlmacen) {

                if (item.IdOrdenServicio.Equals(_idOrdenServicio) || _idOrdenServicio.Equals(0)) {
                    _idOrdenServicio = item.IdOrdenServicio;
                    //break;
                } else {

                    throw new Exception("No se permite descargar Expediente de diferentes Servicios.");

                }

                multipleSeleccionArchivoBase.Ids.Add(item.IdInventario);

            }

            SolPathOrdenDTO solPathOrdenDTO = new SolPathOrdenDTO();

            solPathOrdenDTO.IdOrden = _idOrdenServicio;
            solPathOrdenDTO.IdLineaNegocio = 4;

            //Console.WriteLine("-> SolPathOrdenDTO : " + JsonSerializer.Serialize(solPathOrdenDTO));

            var _ordenServicio = await _ordenservice.ObtenerPath(solPathOrdenDTO);

            if (_ordenServicio.IsSuccess) {

                _pathOrdenServicio = _ordenServicio.strMensaje;

                if (!_pathOrdenServicio.EndsWith("/")) {
                    _pathOrdenServicio += "/";
                }

                DirectoryInfo directoryInfo = new DirectoryInfo(_pathOrdenServicio);
                _pathOrdenServicio = directoryInfo.FullName;

                ////Console.WriteLine($"-> DescargaExpedienteExcel, _pathOrdenServicio: {_pathOrdenServicio}");
                multipleSeleccionArchivoBase.ArchivoBase.RutaBase = _pathOrdenServicio;

            }

            var _resultBase = await _servicioFotograficoService.ObtenerZipArchivos(multipleSeleccionArchivoBase);

            if (_resultBase.Success) {


                

                await JSRuntime.InvokeVoidAsync("AbrirArchivoArregloByte", _resultBase.Data.Archivo,  _resultBase.Data.ContentType, _resultBase.Data.ContenidoBase64);


            } else {

                ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "GuardarEventualidad Tarja", Detail = _resultBase.MensajeRespuesta, Duration = 4000 });
            

            }      

        } catch (Exception ex) {

        }

    }

    void RowRenderInventarioAlmacen(RowRenderEventArgs<MonitorInventarioAlmacen> args)
    {
        if (args.Data != null)
            args.Expandable = args.Data.FechaIngreso != DateTime.MinValue;
    }

    async void RowExpandInventarioAlmacen(MonitorInventarioAlmacen monitorInventarioAlmacen)
    {

        isLoadingFotosRecepcion = true;

        var IdMonitorInventarioSelected = monitorInventarioAlmacen.IdInventario;

        ConsultaCatalogoBase<ConsultaServicioFotografico> _consulta = new ConsultaCatalogoBase<ConsultaServicioFotografico>();
        _consulta.Entidad = new ConsultaServicioFotografico();

        numeroDePagina = 1;
        _consulta.Entidad.IdInventario = IdMonitorInventarioSelected;
        _consulta.Entidad.TipoFoto = TipoFoto.Recepcion;
        _consulta.NumeroDePagina = numeroDePaginaFotoRecepcion;
        _consulta.RegistrosPorPagina = registrosPorPaginaFotoRecepcion;


        var _resultRecepcion = await _servicioFotograficoService.ObtenerListaPaginada(_consulta);

        if (_resultRecepcion.Success) 
        {

            listadoServicioFotografico = _resultRecepcion.Data;

            //////Console.WriteLine("-> monitorServicioFotografico : " + System.Text.Json.JsonSerializer.Serialize(monitorServicioFotografico));
            totalRegistrosFotoRecepcion = (int)_resultRecepcion.Paginado.TotalRegistros;
            

        }

        isLoadingFotosRecepcion = false;

        @* -------------------------------------------------------------------------------------------------------------------------------- *@

        isLoadingFotosEvidenciaDannios = true;


        _consulta = new ConsultaCatalogoBase<ConsultaServicioFotografico>();
        _consulta.Entidad = new ConsultaServicioFotografico();

        numeroDePagina = 1;
        _consulta.Entidad.IdInventario = monitorInventarioAlmacen.IdInventario;
        _consulta.Entidad.TipoFoto = TipoFoto.ReporteDannios;
        _consulta.NumeroDePagina = numeroDePaginaFotoEvidenciaDannios;
        _consulta.RegistrosPorPagina = registrosPorPaginaFotoEvidenciaDannios;


        var _resultEvidenciaDannios = await _servicioFotograficoService.ObtenerListaPaginada(_consulta);

        if (_resultEvidenciaDannios.Success) 
        {

            listadoServicioFotograficoEvidenciaDannios = _resultEvidenciaDannios.Data;

            
            totalRegistrosFotoEvidenciaDannios = (int)_resultEvidenciaDannios.Paginado.TotalRegistros;
            

        }

        isLoadingFotosEvidenciaDannios = false;

        @* -------------------------------------------------------------------------------------------------------------------------------- *@

        await InvokeAsync(StateHasChanged);

    }

