    async Task EliminarTarja() {

        string _mensaje = String.Empty;
        bool _accionEliminar = false;

        if (tarjaSelected != null) {

            if (!tarjaSelected.IdTarja.Equals(0)) 
            {

                _accionEliminar = true;

                var result = await DialogServiceConfirm.Confirm("Desea Eliminar la Tarja?", "Tarja", new ConfirmOptions() { OkButtonText = "Si", CancelButtonText = "No" });

                bool _confirmar = result.HasValue ? (bool)result : false;

                if (_confirmar) {

                    var _result = await _tarjaService.Eliminar(tarjaSelected.IdTarja);

                    if (_result.Success) {

                        ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "La Tarja, se eliminó correctamente", Detail = _mensaje, Duration = 4000 });
                        navigationManager.NavigateTo($"/tarja-crear");

                    } else {

                        _mensaje = _result.MensajeRespuesta;
                        ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Eliminar Tarja", Detail = _mensaje, Duration = 4000 });

                    }

                }

            }

        }

        if (!_accionEliminar) {

            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Eliminar Referencia", 
                Detail = "No existe Referencia seleccionada", Duration = 4000 });

        }


    }

