                                                <RadzenDataGridColumn Title="F. Ingreso" Filterable="false" Width="180px">
                                                    <Template Context="monitorPartida">
                                                        @(monitorPartida.FechaIngreso == DateTime.MinValue ? "" : monitorPartida.FechaIngreso)
                                                    </Template>
