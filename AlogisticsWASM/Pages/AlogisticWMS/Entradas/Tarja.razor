    async void OnConfirmarTarjaRecepcion(MonitorTarja monitorTarja) {

        if (!monitorTarja.IdTarja.Equals(0)) {

            var _result = await _tarjaService.Confirmar(monitorTarja);

            if (_result.Success) {

                ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "La Tarja, se confirmo correctamente", Detail = _result.MensajeRespuesta, Duration = 4000 });

            } else {
                ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Confirmar Tarja", Detail = _result.MensajeRespuesta, Duration = 4000 });
            }

        }

    }

    async void OnImprimirTarjaRecepcion(MonitorTarja monitorTarja) {

        ConsultaTarjaReporteador _consultaTarjaReporte = new ConsultaTarjaReporteador();
        _consultaTarjaReporte.IdTarja = monitorTarja.IdTarja;
        
        var _result = await _reporteTarjaServicie.ObtieneReporteTarjaPatioExterno(_consultaTarjaReporte);

        if (_result.Success) {

            await JSRuntime.InvokeVoidAsync("AbrirArchivoArregloByte", _result.Data.Archivo,  _result.Data.ContentType, Convert.ToBase64String(_result.Data.Content));
            @* var pdfBase64 = $"data:{_result.Data.ContentType};base64, {Convert.ToBase64String(_result.Data.Content)}"; 
            await JSRuntime.InvokeVoidAsync("window.open", pdfBase64, "_blank"); *@

        }

    }

    async void OnSubmit(MonitorTarja monitorTarja)
    {

        ////Console.WriteLine("-> OnSubmit model : " + System.Text.Json.JsonSerializer.Serialize(monitorTarja));


        string _mensaje = String.Empty;
        
        monitorTarja.FechaAlta = DateTime.Now;
        monitorTarja.IdEmpresaLogin = 1;
        monitorTarja.Estado = (EstadoTarja)valEstadoTarja;
        monitorTarja.TipoTarja = TipoTarja.Entrada;
        monitorTarja.TipoServicio = (TipoServicioTarja)valTipoServicio;

        if (monitorTarja.IdTarja.Equals(0)) {
                monitorTarja.Folio = 0;
                monitorTarja.CRUDAction = ECRUDAction.Create;
        } else {
            monitorTarja.Folio = Convert.ToInt32(FolioTarja);
            monitorTarja.CRUDAction = ECRUDAction.Update;
        }

        var _resultBase = await _tarjaService!.Guardar(monitorTarja);

        if (_resultBase.Success) {

            monitorTarja.IdTarja = _resultBase.Id;

            monitorTarja.Folio = _resultBase.Data.Folio;

            tarjaSelected.IdTarja = _resultBase.Id;

            tarjaSelected.Folio = _resultBase.Data.Folio;

            tarjaSelected.ClaveReferencia = _resultBase.Data.ClaveReferencia;

            disabledTipoServicio = true;

            disabledBtnCrearPartida = false;

            disabledBtnCargaMasiva = false;

            FolioTarja = monitorTarja.Folio.ToString();

            ////Console.WriteLine("-> Folio Tarja: " + FolioTarja);
            
            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "La Tarja, se guardo correctamente", Detail = _mensaje, Duration = 4000 });
            
        } else {
            _mensaje = _resultBase.MensajeRespuesta;
            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Guardar Tarja", Detail = _mensaje, Duration = 4000 });
            
        }


        await InvokeAsync(StateHasChanged);

    }

