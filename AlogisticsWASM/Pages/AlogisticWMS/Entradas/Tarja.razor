    async void OnClientChange(UploadChangeEventArgs args)
    {
        ////Console.WriteLine($"Client-side upload changed");

        InvokeAsync(async () =>
        {

                string _mensaje = string.Empty;

                byte[] bytes;

                cargaMasiva = new CargaMasiva();

                cargaMasiva.IdTarja = tarjaSelected.IdTarja;

                cargaMasiva.ArchivoBase = new ArchivoBase();

                foreach (var file in args.Files)
                {
                    ////Console.WriteLine($"File: {file.Name} / {file.Size} bytes");

                    cargaMasiva.ArchivoBase.Archivo = file.Name;
                    cargaMasiva.ArchivoBase.ContentType = file.ContentType;

                    try
                    {
                        long maxFileSize = 10 * 1024 * 1024;
                        // read file
                        var stream = file.OpenReadStream(maxFileSize);
                                        
                        using var ms = new MemoryStream();
                        await stream.CopyToAsync(ms);      

                        stream.Close();

                        bytes = ms.ToArray();
            
                        cargaMasiva.ArchivoBase.Content = bytes;

                        var _resultBase = await _tarjaService!.GuardarCargaMasiva(cargaMasiva);

                        if (_resultBase.Success) {
                            ////Console.WriteLine("-> Carga de datos del inventario");

                            _mensaje = _resultBase.MensajeRespuesta;
                            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "La Carga Masiva se completo correctamente.", Detail = _mensaje, Duration = 4000 });

                            await ObtenerDatosPartidas(_args);

                        } else {
                            _mensaje = _resultBase.MensajeRespuesta;
                            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "La Carga Masiva no se completo correctamente.", Detail = _mensaje, Duration = 4000 });
                            throw new Exception(_resultBase.MensajeRespuesta);
                        }

                    }
                    catch (Exception ex)
                    {
                        ////Console.WriteLine($"Client-side file read error: {ex.Message}");
                        BusyDialogService.Close();
                    }
                    finally 
                    {

                    }
                }

                BusyDialogService.Close();

                await InvokeAsync(StateHasChanged);

        });

        await BusyDialog("Procesando Información...");

        
    }

    protected override async void OnParametersSet()
    {

         base.OnParametersSet();

        //Console.WriteLine("--> OnParametersSet 4444 ");

         if (!String.IsNullOrEmpty(DataReferencia)) {

           //Console.WriteLine("--> OnParametersSet entra");

            byte[] binaryData = Convert.FromBase64String(DataReferencia);
            string decodedString = System.Text.Encoding.UTF8.GetString(binaryData);

            ////Console.WriteLine("Decoded: " + decodedString);

            referenciaDTO = new ReferenciaDTO();

            referenciaDTO = JsonConvert.DeserializeObject<ReferenciaDTO>(decodedString);

            tarjaSelected = new MonitorTarja();

            if (!referenciaDTO.IdTarja.Equals(0)) {

                visibleTarjaFolioReferencia = true;

                var _resultBase = await _tarjaService.ObtenerPorId(referenciaDTO.IdTarja);

                if (_resultBase.Success) {

                    tarjaSelected.Folio = _resultBase.Data.Folio;
                    tarjaSelected.TipoTarja = _resultBase.Data.TipoTarja;
                    tarjaSelected.FolioReferencia = _resultBase.Data.FolioReferencia;
                    tarjaSelected.FechaIngreso = _resultBase.Data.FechaIngreso;

                    FolioTarja = tarjaSelected.ClaveReferencia;

                    FolioReferencia = tarjaSelected.FolioReferencia;

                    tarjaSelected.IdTarja = _resultBase.Data.IdTarja;
                    tarjaSelected.Estado = _resultBase.Data.Estado;
                    tarjaSelected.TipoTarja = _resultBase.Data.TipoTarja;
                    tarjaSelected.TipoServicio = _resultBase.Data.TipoServicio;
                    tarjaSelected.Observaciones = _resultBase.Data.Observaciones;
                    tarjaSelected.ClaveReferencia = _resultBase.Data.ClaveReferencia;

                    tarjaSelected.IdReferencia =  referenciaDTO.IdReferencia;

                    disabledBtnCargaMasiva = false;
                    disabledBtnCrearPartida = false;
                    visibleGridPartida = true;

                    _tipoServicioTarja = tarjaSelected.TipoServicio;

                    valEstadoTarja = (int)tarjaSelected.Estado;

                    valTipoServicio = (int)_tipoServicioTarja;

                    valFechaIngreso = (DateTime)tarjaSelected.FechaIngreso;

                    disabledTipoServicio = !tarjaSelected.Estado.Equals(EstadoTarja.Preliminar);


                } else {

                }
            } else if (!referenciaDTO.IdReferencia.Equals(0)) {

                visibleTarjaFolioReferencia = true;
                
                FolioReferencia = referenciaDTO!.FolioReferencia;    

                tarjaSelected.FolioReferencia = FolioReferencia;

                tarjaSelected.IdReferencia = referenciaDTO.IdReferencia;

            }

            await ObtenerDatosPartidas(_args);

            await InvokeAsync(StateHasChanged);

        } else {

            tarjaSelected = new MonitorTarja();
           //Console.WriteLine("--> OnParametersSet Se inicializar MonitorTarja ");

        }

        
    }

    private async Task ObtenerDatosPartidas(LoadDataArgs args) {

        isLoading = true;

        //await JSRuntime.InvokeVoidAsync("window.localStorage.setItem", "DialogSettings", JsonSerializer.Serialize<DialogSettings>(Settings));

        if (args != null) {
            numeroDePagina = ((int)args.Skip/registrosPorPagina) + 1;
        }

        ConsultaCatalogoBase<ConsultaPartida> _consultaPartida = new ConsultaCatalogoBase<ConsultaPartida>();
        _consultaPartida.Entidad = new ConsultaPartida();
        _consultaPartida.Entidad.IdTarja = tarjaSelected.IdTarja;
        _consultaPartida.NumeroDePagina = numeroDePagina;
        _consultaPartida.RegistrosPorPagina = registrosPorPagina;

        var _listMonitorPartidas = await _partidaService!.ObtenerListaPaginadaPorIdTarja(_consultaPartida);

        ////Console.WriteLine("--> PoC ");

        totalRegistros = (int)_listMonitorPartidas.Paginado.TotalRegistros;

        ////Console.WriteLine("--> totalRegistros: " + totalRegistros);

        listMonitorPartidas = _listMonitorPartidas.Data;

        selectedPartida = listMonitorPartidas.Take(1).ToList();

         
        if (totalRegistros.Equals(0)) {
            ////Console.WriteLine("--> visible Grid Partida: false");
            visibleGridPartida = false;
        } else {
            ////Console.WriteLine("--> visible Grid Partida: true");
            visibleGridPartida = true;

        }

        isLoading = false;

        await InvokeAsync(StateHasChanged);

    }

    private  byte[] UseBinaryReader(Stream stream)
    {
        byte[] bytes;
        using (var binaryReader = new BinaryReader(stream))
        {
            bytes = binaryReader.ReadBytes((int)stream.Length);
        }
        return bytes;
    }

