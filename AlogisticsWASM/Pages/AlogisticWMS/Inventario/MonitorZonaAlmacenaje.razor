@code {
    int MaxFilas = 30;

    int MaxColumnas = 10; 

    int TempFilas = 30;

    int TempColumnas = 10;

    string ClaveZona = String.Empty;

    string LabelCapacidadTotal = String.Empty;

    string LabelOcupacionActual = String.Empty;

    int SelectedFilas = 1;

    int SelectedColumna = 1;

    string CurrentItem;

    bool IsEdicion = false;

    string OriginalItemValue;

    bool IsAgregar = false;

    string NuevoItem  = string.Empty;

    @* -------------------------------------------------------- *@

    bool responsive = true;

    Variant variant = Variant.Filled;

    double _zonaAlmacenProgress = 0;

    int valZonaAlmacenaje = 1;

    List<MonitorZonaAlmacen> listTipoZonaAlmacenaje;

    List<MonitorUbicacionAlmacen> listaMonitorUbicacionAlmacen;

    @* -------------------------------------------------------- *@

    [Inject] private IInventarioAlmacenService? _inventarioAlmacenService {get; set; }
    
    [Inject] private IPartidaService? _partidaService { get; set; }

    [Inject] private IZonaAlmacenService? _zonaAlmacenService { get; set; }

    [Inject] private IUbicacionAlmacenService? _ubicacionAlmacenService { get; set; }
    
    private Dictionary<(int row, int col), string> StorageMap = new() { };
    
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await ObtenerDatosZonaAlmacen();

        
    }

    @* ----------------------------------------------------------------------------------------------------- *@

    async Task UpdateZonaAlmacenaje()
    {
        //Console.WriteLine("valZonaAlmacenaje: " + valZonaAlmacenaje.ToString());

        await ObtenerDatosZonaAlmacen();
    }
    
    private async Task ObtenerDatosZonaAlmacen() 
    {

        listTipoZonaAlmacenaje = new List<MonitorZonaAlmacen>();

        _zonaAlmacenProgress = 0;

        LabelOcupacionActual = "0 Unidades";

        var _resultBase = await _zonaAlmacenService!.ObtenerLista();

        //Console.WriteLine("--> PoC ");

        StorageMap = new()
        { };

        if (_resultBase.Success) {

            listTipoZonaAlmacenaje = _resultBase.Data;

            var _dimensionAlmanceTotal = (from x in listTipoZonaAlmacenaje where x.IdZonaAlmacenaje.Equals(valZonaAlmacenaje)
            select new { 
                    IdZonaAlmacenaje = x.IdZonaAlmacenaje,
                    TotalFilas = x.TotalFilas, 
                    TotalColumnas = x.TotalColumnas,
                    ClaveZona = x.Clave }).SingleOrDefault();

            MaxFilas = _dimensionAlmanceTotal.TotalFilas;
            MaxColumnas = _dimensionAlmanceTotal.TotalColumnas;  

            LabelCapacidadTotal = (MaxFilas * MaxColumnas).ToString() + " Unidades";

            ClaveZona = _dimensionAlmanceTotal.ClaveZona;

            TempFilas = MaxFilas;
            TempColumnas = MaxColumnas;

            //Obtener el inventario asociado a la Zona Almacen Seleccioada

            var _resultUbicaciones = await _ubicacionAlmacenService.ObtenerListaUbicacionPorIdAlmacenaje(_dimensionAlmanceTotal.IdZonaAlmacenaje);

            if (_resultUbicaciones.Success) {

                if (!_resultUbicaciones.Data.Count.Equals(0)) {

                    ActualizarItemDisplay();

                    _zonaAlmacenProgress = (_resultUbicaciones.Data.Count*100)/(MaxFilas * MaxColumnas);             

                    LabelOcupacionActual = _resultUbicaciones.Data.Count.ToString() + " Unidades";

                    //Console.WriteLine("-> _resultUbicaciones : " + JsonSerializer.Serialize(_resultUbicaciones.Data));

                    foreach(var item in _resultUbicaciones.Data) {

                        //var _listClaveUbicacion = item.Descripcion.Split('|').ToList();
                        string[] _listClaveUbicacion = item.Descripcion.Split('|');

                        SelectedFilas = Convert.ToInt32(_listClaveUbicacion[2]);

                        SelectedColumna = Convert.ToInt32(_listClaveUbicacion[4]);

                        CurrentItem = item.Numeros;

                        StorageMap[(SelectedFilas, SelectedColumna)] = CurrentItem;

                    }

                    SelectCelda(1, 1);
                }

            }
            
            SelectCelda(1, 1);

        }

        await InvokeAsync(StateHasChanged);

    }

    @* ----------------------------------------------------------------------------------------------------- *@

    private string ObtenerCeldaClass(int row, int col)
    {
        var classes = new List<string>();
        
        if (row == SelectedFilas && col == SelectedColumna)
            classes.Add("selected");
        
        if (IsCeldaOcupada(row, col))
            classes.Add("occupied");
        
        return string.Join(" ", classes);
    }
    
    private bool IsCeldaOcupada(int row, int col)
    {
        return StorageMap.ContainsKey((row, col));
    }
    
    private void SelectCelda(int row, int col)
    {
        // Aseguramos que los valores estén dentro de los límites
        SelectedFilas = Math.Clamp(row, 1, MaxFilas);
        SelectedColumna = Math.Clamp(col, 1, MaxColumnas);
        ActualizarItemDisplay();
        IsEdicion = false;
        StateHasChanged(); // Forzar actualización de la UI
    }
    
    private void OnLocationChanged()
    {
        ActualizarItemDisplay();
        IsEdicion = false;
    }
    
    private void ActualizarItemDisplay()
    {
        if (IsCeldaOcupada(SelectedFilas, SelectedColumna))
        {
            CurrentItem = StorageMap[(SelectedFilas, SelectedColumna)];
        }
        else
        {
            NuevoItem = string.Empty;
            CurrentItem = string.Empty;
        }
    }
    
    private void IniciarAgregarItem()
    {
        NuevoItem = string.Empty;
        IsAgregar = true;
    }

    private void ConfirmarAddItem()
    {
        if (!string.IsNullOrWhiteSpace(NuevoItem))
        {
            StorageMap[(SelectedFilas, SelectedColumna)] = NuevoItem;
            CurrentItem = NuevoItem;
            IsAgregar = false;
            StateHasChanged();
        }
        else
        {
            // Mostrar mensaje de error
        }
    }
    
    private void IniciarEdicion()
    {
        OriginalItemValue = CurrentItem;
        IsEdicion = true;
    }
    
    private void GuardarItem()
    {
        if (!string.IsNullOrWhiteSpace(CurrentItem))
        {
            StorageMap[(SelectedFilas, SelectedColumna)] = CurrentItem;
        }
        IsEdicion = false;
    }

    private void CancelAgregar()
    {
        NuevoItem = string.Empty;
        IsAgregar = false;
    }
    
    private void CancelEdicion()
    {
        CurrentItem = OriginalItemValue;
        IsEdicion = false;
    }
    
    private void ReleaseLocation()
    {
        if (IsCeldaOcupada(SelectedFilas, SelectedColumna))
        {
            StorageMap.Remove((SelectedFilas, SelectedColumna));
            CurrentItem = string.Empty;
            IsEdicion = false;
        }
    }

     private void ResizeStorage()
    {
        // Crear nuevo diccionario para los items que caben en la nueva dimensión
        var newStorage = new Dictionary<(int, int), string>();
        
        foreach (var item in StorageMap)
        {
            if (item.Key.Item1 <= TempFilas && item.Key.Item2 <= TempColumnas)
            {
                newStorage.Add(item.Key, item.Value);
            }
        }
        
        // Actualizar dimensiones y almacenamiento
        MaxFilas = TempFilas;
        MaxColumnas = TempColumnas;
        StorageMap = newStorage;
        
        // Ajustar selección si está fuera de los nuevos límites
        SelectedFilas = Math.Min(SelectedFilas, MaxFilas);
        SelectedColumna = Math.Min(SelectedColumna, MaxColumnas);
        
        StateHasChanged();
    }

}

