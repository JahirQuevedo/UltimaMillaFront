                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenText TextStyle="TextStyle.H6">Ocupación</RadzenText>
                                    <RadzenText TextStyle="TextStyle.H2" class="rz-m-0">@($"{Math.Round(_zonaAlmacenProgress)}%")</RadzenText>
                                </RadzenStack>
                                <RadzenProgressBar @bind-Value=@_zonaAlmacenProgress ShowValue="false" Style="--rz-progressbar-height: 1rem;"/>
                            </RadzenStack>
                        </RadzenCard>
                        <RadzenCard Variant="@variant" class="rz-mx-auto rz-border-radius-2" Style="width: 100%">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="1rem">
                                <RadzenStack Gap="0">
                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-2 rz-my-0">Capacidad Total del Almacén</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body1"><b>@(LabelCapacidadTotal)</b></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-4 rz-mb-0">Ocupación Actual</RadzenText>
