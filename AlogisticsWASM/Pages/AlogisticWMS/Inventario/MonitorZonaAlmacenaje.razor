        </RadzenColumn>
        <RadzenColumn >
            <RadzenStack class="rz-mt-0">
                
                        <RadzenCard Variant="@variant" class="rz-background-color-info-lighter rz-shadow-0 rz-border-radius-2 rz-p-4">
