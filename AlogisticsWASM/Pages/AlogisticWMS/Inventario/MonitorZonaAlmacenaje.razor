                            <RadzenDropDown @bind-Value=@valZonaAlmacenaje ValueProperty="@nameof(MonitorZonaAlmacen.IdZonaAlmacenaje)" 
                                                        Style="width: 100%;"
                                                        Change="@(args => UpdateZonaAlmacenaje())"
                                                        TextProperty="Descripcion" Data=@listTipoZonaAlmacenaje
                                                        Name="UBICACION_TIPO_ZONA_ALMACENAJE" />
                    </RadzenColumn>
                    <RadzenColumn Size="1" class="text-center align-content-center">
                        <RadzenIcon Icon="my_location" style="font-size: 56px;" />
                    </RadzenColumn>
                    <RadzenColumn Size="5">
                        <RadzenLabel Text="Ubicación seleccionada:" Component="UBICACION_ALMACENAJE" />
                        <RadzenTextBox Value="@($"Fila {SelectedFilas}, Cajón {SelectedColumna}")"
                                    
                                    Disabled="true" Style="width: 100%" Name="UBICACION_ALMACENAJE" />
                    </RadzenColumn>
                </RadzenRow>
                <div class="storage-grid">
                    @for (int row = 1; row <= MaxFilas; row++)
                    {
                        <div class="storage-row">
                            @for (int col = 1; col <= MaxColumnas; col++)
                            {
                                var currentFilas = row; // Captura local para el cierre
                                var currentCol = col; // Captura local para el cierre
                                
                                <div class="storage-cell @ObtenerCeldaClass(currentFilas, currentCol)" 
                                    @onclick="() => SelectCelda(currentFilas, currentCol)">
                                    <div class="cell-coords">@(ClaveZona)F@(currentFilas)C@(currentCol)</div>
                                    @if (IsCeldaOcupada(currentFilas, currentCol))
                                    {
                                        <div class="item-info">
                                            <span class="item-badge">
                                                <RadzenIcon Icon="directions_car" style="font-size: 24px;" />
                                            </span>
                                            <div class="item-details">
                                                @StorageMap[(currentFilas, currentCol)]
                                            </div>
                                        </div>
                                    }
                                    @if (currentFilas == SelectedFilas && currentCol == SelectedColumna)
                                    {
                                        <span class="selection-marker">★</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                
