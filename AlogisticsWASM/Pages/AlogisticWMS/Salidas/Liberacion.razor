                            <RadzenLabel Text="Estado" Component="LIBERACION_ESTATUS" />
                            <RadzenDropDown @bind-Value="valEstadoLiberacion" ValueProperty="Key" 
                                TextProperty="Value" Data=@_listEstadoLiberacion
                                Style="width: 100%;"
                                Name="LIBERACION_ESTATUS" />
