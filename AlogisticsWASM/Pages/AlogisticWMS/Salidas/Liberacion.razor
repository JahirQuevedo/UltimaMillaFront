    private BadgeStyle BadgeStyleEstadoLiberacion(EstadoLiberacion estadoLiberacion) {

        switch(estadoLiberacion) {

            case EstadoLiberacion.Cerrada : return BadgeStyle.Success;
            case EstadoLiberacion.Pendiente : return BadgeStyle.Base;
            case EstadoLiberacion.Cancelada : return BadgeStyle.Danger;
            case EstadoLiberacion.None : return BadgeStyle.Light;
            default : return BadgeStyle.Light;
        }

    }

    private bool DisabledByEstadoLiberacion(MonitorLiberacionInventario data) {

        return data.EstadoLiberacion.Equals(EstadoLiberacion.Cancelada) || data.EstadoLiberacion.Equals(EstadoLiberacion.Cerrada);
    }

    async Task BusyDialog(string message)
    {
        await BusyDialogService.OpenAsync("", ds =>
        {
            RenderFragment content = b =>
            {
                b.OpenElement(0, "RadzenRow");

                b.OpenElement(1, "RadzenColumn");
                b.AddAttribute(2, "Size", "12");

                b.AddContent(3, message);

                b.CloseElement();
                b.CloseElement();
            };
            return content;
        }, new DialogOptions() { ShowTitle = false, Style = "min-height:auto;min-width:auto;width:auto", CloseDialogOnEsc = false });
    }
