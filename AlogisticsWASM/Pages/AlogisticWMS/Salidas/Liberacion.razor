                        @* <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                            <RadzenLabel Text="Estatus:" Component="DropDownEstatus" />
                            <RadzenDropDown @bind-Value=@valEstadoTurno Data=@_listEstadoTurno Change=@DropDownOnEstatusChange 
                            
                            Style="width: 100%; max-width: 200px;" Name="DropDownEstatus" />
                            
                        </RadzenStack> *@
                        <RadzenButton Text="Buscar" Icon="search" Click="@(args => BurcarLiberacionInventario())" />
                    </RadzenStack>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="3">
                        <RadzenLabel Text="Cliente" Component="LIB_MERCANCIA_RAZONSOCIAL_CLIENTE"/>
                        <RadzenAutoComplete @bind-Value=@_consultaLiberacionInventario.Cliente Data=@listaCliente
                            Name="LIB_MERCANCIA_RAZONSOCIAL_CLIENTE" Change=@OnChangeCliente class="rz-text-uppercase"
                            ValueProperty="@nameof(RespListarCoincidenciasDTO.Id)"
                            TextProperty="@nameof(RespListarCoincidenciasDTO.RazonSocial)" LoadData=@OnLoadDataCliente Style="width: 100%; text-transform: capitalize;" 
                            InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Cliente" }})" />
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenLabel Text="Numeros/VIN" Component="LIB_MERCANCIA_NUMEROS"/>
                        <RadzenTextBox Style="width: 100%;" @bind-Value="@_consultaLiberacionInventario.IdMercancia"
                            Name="LIB_MERCANCIA_NUMEROS" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </ChildContent>
    </RadzenPanel>
    <RadzenStack class="rz-mt-0">
        <RadzenRow>
            <RadzenColumn Size="6" SizeMD="6">
                <RadzenButton Click=@(args => OpenAsignarMercancia(null)) Text="Mercancía" Icon="add_circle"  />
                @* <RadzenButton Click=@(args => OnClick("Crear Viaje button")) Text="Crear Viaje" Icon="add_circle" /> *@
                @* <RadzenButton Text="Asignar Servicio a Referencia" Icon="add_circle" ButtonStyle="ButtonStyle.Primary" class="rz-background-color-danger" />    *@
                <RadzenSplitButton Click=@(args => OnClickSplitButton(args, "SplitButton with text and icon")) Text="Acciones Liberación" 
                        ButtonStyle="ButtonStyle.Primary"
                        Icon="lists">
                    <ChildContent>
                        @* <RadzenSplitButtonItem Text="Autorizar Liberación" Value="1" Icon="account_box" /> *@
                        <RadzenSplitButtonItem Text="Salida Almacén" Value="1" Icon="account_balance_wallet" />
                    </ChildContent>
