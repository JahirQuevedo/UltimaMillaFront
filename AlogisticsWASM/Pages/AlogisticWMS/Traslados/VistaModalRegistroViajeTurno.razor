    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        listaManiobristaOrigen = new List<MonitorManiobrista>();
        listaManiobristaDestino = new List<MonitorManiobrista>();
        listaLineaTransporte = new List<MonitorLineaTransporte>();
