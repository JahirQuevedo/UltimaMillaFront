        monitorCtrlTransporteSelected.IdOrdenSalida = monitorCtrlTransporte.IdOrdenSalida;
        monitorCtrlTransporteSelected.IdSolicitudTraslado = monitorCtrlTransporte.IdSolicitudTraslado;
        monitorCtrlTransporteSelected.IdControlTransporte = monitorCtrlTransporte.IdCatTransportista;
        monitorCtrlTransporteSelected.TipoViaje = monitorCtrlTransporte.TipoViaje;
        valTipoViaje = monitorCtrlTransporteSelected.TipoViaje.ToString();

        if (monitorCtrlTransporte != null) {
            
            if (!monitorCtrlTransporte.IdControlTransporte.Equals(0)) {
                    
                var resultBase =  await _controlTransporteService.ObtenerPorId(monitorCtrlTransporte.IdControlTransporte);

                if (resultBase.Success) {

                    monitorCtrlTransporteSelected = new MonitorCtrlTransporte();
                    monitorCtrlTransporteSelected = resultBase.Data;
                    valEstadoTurno = resultBase.Data.Estado.ToString();
                    valTipoViaje = resultBase.Data.TipoViaje.ToString();
                    FolioTurno = resultBase.Data.FolioTurno.ToString();
                    valTipoViaje = monitorCtrlTransporteSelected.TipoViaje.ToString();
                    
                }

            } else if (!monitorCtrlTransporte.IdSolicitudTraslado.Equals(0)) {

                monitorCtrlTransporteSelected.IdCatTransportista = monitorCtrlTransporte.IdCatTransportista;
                monitorCtrlTransporteSelected.RazonSocialLineaTransporte = monitorCtrlTransporte.RazonSocialLineaTransporte;
                monitorCtrlTransporteSelected.IdManiobristaOrigen = monitorCtrlTransporte.IdManiobristaOrigen;
                monitorCtrlTransporteSelected.IdManiobristaDestino = monitorCtrlTransporte.IdManiobristaDestino;
                monitorCtrlTransporteSelected.ManiobristaOrigen = monitorCtrlTransporte.ManiobristaOrigen;
                monitorCtrlTransporteSelected.ManiobristaDestino = monitorCtrlTransporte.ManiobristaDestino;

            }

        } 


    }

