    async Task OnLoadDataTipoTransporte(LoadDataArgs args) {

        //listaTipoTransporte = new List<TipoTransporte>();
            
        var resultBase = await _tipoTransporteService.ObtenerPorNombreContiene(args.Filter);
        if (resultBase.Success) {

            listaTipoTransporte = resultBase.Data;

            if (listaTipoTransporte.Count.Equals(0)) {
                ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Tipo de Transporte", Detail = "No se encontró la descripción solicitada.", Duration = 4000 });
                tipoTransporteSelected = String.Empty;
            }
        } else {
            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Tipo de Transporte", Detail = "No se encontró la descripción solicitada.", Duration = 4000 });
            tipoTransporteSelected = String.Empty;
        }

    }

