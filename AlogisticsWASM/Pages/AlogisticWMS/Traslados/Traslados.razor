    private async Task ObtenerDatosSolicitudTraslado(LoadDataArgs args) {

        isLoading = true;
        ////Console.WriteLine("-> Obtener Datos args : " + JsonSerializer.Serialize(args));

        ConsultaCatalogoBase<ConsultaCtrlTransporte> _consultaControlTransporte = new ConsultaCatalogoBase<ConsultaCtrlTransporte>();
        _consultaControlTransporte.Entidad = new ConsultaCtrlTransporte();
        _consultaControlTransporte.Entidad.EstadoTurno = (EstadoTurno)valEstadoTurno;

        _consultaControlTransporte.Entidad.FechaInicio = _consultaCtrlTransporte.FechaInicio;
        _consultaControlTransporte.Entidad.FechaFin = _consultaCtrlTransporte.FechaFin;

        if (args != null) {
            numeroDePagina = ((int)args.Skip/registrosPorPagina) + 1;
        }
    
        _consultaControlTransporte.NumeroDePagina = numeroDePagina;
        _consultaControlTransporte.RegistrosPorPagina = registrosPorPagina;

        var _listMonitorControlTransporte = await _controlTransporteService!.ObtenerListaPaginada(_consultaControlTransporte);

        ////Console.WriteLine("--> PoC ");

        totalRegistros = (int)_listMonitorControlTransporte.Paginado.TotalRegistros;

        ////Console.WriteLine("--> totalRegistros: " + totalRegistros);

        listaMonitorControlTransporte = _listMonitorControlTransporte.Data;

        selectedControlTransporte = listaMonitorControlTransporte.Take(1).ToList();

        isLoading = false;

    }

    private async Task ObtenerDatosControlTransporte(LoadDataArgs args) {

        isLoading = true;
        ////Console.WriteLine("-> Obtener Datos args : " + JsonSerializer.Serialize(args));

        ConsultaCatalogoBase<ConsultaCtrlTransporte> _consultaControlTransporte = new ConsultaCatalogoBase<ConsultaCtrlTransporte>();
        _consultaControlTransporte.Entidad = new ConsultaCtrlTransporte();
        _consultaControlTransporte.Entidad.EstadoTurno = (EstadoTurno)valEstadoTurno;
        _consultaControlTransporte.Entidad.TipoViaje = TipoViaje.Entrada;

        _consultaControlTransporte.Entidad.FechaInicio = _consultaCtrlTransporte.FechaInicio;
        _consultaControlTransporte.Entidad.FechaFin = _consultaCtrlTransporte.FechaFin;

        if (args != null) {
            numeroDePagina = ((int)args.Skip/registrosPorPagina) + 1;

            var _filterPlacas = args.Filters.Where(p => p.Property.Equals("PlacasLineaTransporte")).FirstOrDefault();
            if (_filterPlacas != null) {
                _consultaControlTransporte.Entidad.Placas = String.IsNullOrEmpty(_filterPlacas.FilterValue.ToString()) ? null : _filterPlacas.FilterValue.ToString();
            }

            var _filterNumEco = args.Filters.Where(p => p.Property.Equals("NumEcoLineaTransporte")).FirstOrDefault();
            if (_filterNumEco != null) {
                _consultaControlTransporte.Entidad.NumeroEconomico = String.IsNullOrEmpty(_filterNumEco.FilterValue.ToString()) ? null : _filterNumEco.FilterValue.ToString();
            }

            var _filterTermOrig = args.Filters.Where(p => p.Property.Equals("ManiobristaNombreCortoOrigen")).FirstOrDefault();
            if (_filterTermOrig != null) {
                _consultaControlTransporte.Entidad.TerminalOrigen = String.IsNullOrEmpty(_filterTermOrig.FilterValue.ToString()) ? null : _filterTermOrig.FilterValue.ToString();
            }

            var _filterTransportista = args.Filters.Where(p => p.Property.Equals("RazonSocialLineaTransporte")).FirstOrDefault();
            if (_filterTransportista != null) {
                _consultaControlTransporte.Entidad.NombreTransportista = String.IsNullOrEmpty(_filterTransportista.FilterValue.ToString()) ? null : _filterTransportista.FilterValue.ToString();
            }
            
            var _filterEstadoTurno = args.Filters.Where(p => p.Property.Equals("Estado")).FirstOrDefault();
            if (_filterEstadoTurno != null) {
                _consultaControlTransporte.Entidad.EstadoTurno = (EstadoTurno)_filterEstadoTurno.FilterValue;
            }

        }
    
        _consultaControlTransporte.NumeroDePagina = numeroDePagina;
        _consultaControlTransporte.RegistrosPorPagina = registrosPorPagina;

        var _listMonitorControlTransporte = await _controlTransporteService!.ObtenerListaPaginada(_consultaControlTransporte);

        ////Console.WriteLine("--> PoC ");

        totalRegistros = (int)_listMonitorControlTransporte.Paginado.TotalRegistros;

        ////Console.WriteLine("--> totalRegistros: " + totalRegistros);

        listaMonitorControlTransporte = _listMonitorControlTransporte.Data;

        selectedControlTransporte = listaMonitorControlTransporte.Take(1).ToList();

        isLoading = false;

    }

    public async Task SetEstadoTurnoViaje(MonitorCtrlTransporte monitorCtrlTransporte, EstadoTurno estadoTurno) {

        bool _confirmar = false;

        if (monitorCtrlTransporte.Estado.Equals(EstadoTurno.Cancelado)) {

            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Viaje", 
            Detail = $"El Viaje ya se encuentra cancelado", 
            Duration = 4000 });

        } else {

            if (monitorCtrlTransporte.Estado.Equals(EstadoTurno.Creado) || !monitorCtrlTransporte.Estado.Equals(estadoTurno))
            {
                if (!monitorCtrlTransporte.Estado.Equals(EstadoTurno.Iniciado) && estadoTurno.Equals(EstadoTurno.Completado)) {

                    ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Viaje", 
                    Detail = $"No se puede Finalizar un Viaje que no ha sido Iniciado", 
                    Duration = 4000 });

                } else {

                    var result = await DialogInicioFinViaje.Confirm("Desea " + (estadoTurno.Equals(EstadoTurno.Iniciado) ? "iniciar" : estadoTurno.Equals(EstadoTurno.Completado) ? "finalizar" : "cancelar") + " el Viaje ?", 
                                        "Folio de Viaje: " + monitorCtrlTransporte.FolioTurno.ToString(), new ConfirmOptions() { OkButtonText = "Si", CancelButtonText = "No" });

                    _confirmar = result.HasValue ? (bool)result : false;

                    if (_confirmar) {

                        monitorCtrlTransporte.IdEmpresaLogin = 1;
                        monitorCtrlTransporte.Estado = estadoTurno;
                        if (estadoTurno.Equals(EstadoTurno.Iniciado)) {
                            monitorCtrlTransporte.FechaInicio = DateTime.Now;
                        } else if (estadoTurno.Equals(EstadoTurno.Completado)) {
                            monitorCtrlTransporte.FechaFin = DateTime.Now;
                        } else if (estadoTurno.Equals(EstadoTurno.Cancelado)) {
                            monitorCtrlTransporte.FechaCancelacion = DateTime.Now;
                        }
                        monitorCtrlTransporte.CRUDAction = ECRUDAction.Update;
                        
                        var resultBase = await _controlTransporteService.Guardar(monitorCtrlTransporte);

                        if (resultBase.Success) {
                            
                            await ObtenerDatosControlTransporte(_args);

                            await InvokeAsync(StateHasChanged);

                        } else {

                            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Viaje", 
                                Detail = $"Error: {resultBase.MensajeRespuesta}", 
                                Duration = 4000 });

                        }

                    }

                }

            } else {
                ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Viaje", 
                Detail = $"El Viaje ya se encuentra {(EstadoTurno)estadoTurno}", 
                Duration = 4000 });
            }

        }

    }

    public async Task OpenRegistroViaje(MonitorCtrlTransporte monitorCtrlTransporte)
    {
        await LoadStateAsync();

        if (monitorCtrlTransporte != null)
            _monitorControlTransporte = monitorCtrlTransporte;
        else {
            _monitorControlTransporte = new MonitorCtrlTransporte();
        }

        _monitorControlTransporte.TipoViaje = TipoViaje.Entrada;

        await DialogRegistroViaje.OpenAsync<VistaModalRegistroViajeTurno>($"Viaje",
               new Dictionary<string, object>() { { "IdControlTransporte", _monitorControlTransporte.IdControlTransporte }, { "monitorCtrlTransporte", _monitorControlTransporte} },
               new DialogOptions() 
               {
                   Resizable = false, 
                   Draggable = true,
                   Resize = OnResize,
                   Drag = OnDrag,
                   Width = "860px", 
                   Height = "550px"
                });

        await ObtenerDatosControlTransporte(_args);

        await InvokeAsync(StateHasChanged);

        await SaveStateAsync();
    }

