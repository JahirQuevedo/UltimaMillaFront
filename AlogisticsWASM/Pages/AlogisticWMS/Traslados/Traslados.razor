    async void RowExpandControlTransporte(MonitorCtrlTransporte monitorCtrlTransporte)
    {

            IdMonitorControlTransporteSelected = monitorCtrlTransporte.IdControlTransporte;

            InvokeAsync(async () =>
            {
                await LoadStateAsync();

                ConsultaCatalogoBase<ConsultaSolicitudTraslado> _consultaTraslado = new ConsultaCatalogoBase<ConsultaSolicitudTraslado>();
                _consultaTraslado.Entidad = new ConsultaSolicitudTraslado();
                _consultaTraslado.Entidad.IdControlTransporte = monitorCtrlTransporte.IdControlTransporte;
                _consultaTraslado.NumeroDePagina = numeroDePaginaTraslado;
                _consultaTraslado.RegistrosPorPagina = registrosPorPaginaTraslado;
                _consultaTraslado.Entidad.FechaInicio = DateTime.MinValue;
                _consultaTraslado.Entidad.FechaFin = DateTime.MinValue;

                var result = await _solicitudTrasladoService!.ObtenerListaPaginada(_consultaTraslado);

                if (result.Success) {

                    listaMonitorSolicitudTraslado = result.Data;

                    totalRegistrosTraslado = (int)result.Paginado.TotalRegistros;
                }

                DialogService.Close();

                await InvokeAsync(StateHasChanged);

                await SaveStateAsync();

             });

            await BusyDialog("Cargando Información...");

            
    }

