    async Task BusyDialog(string message)
    {
        await DialogService.OpenAsync("", ds =>
        {
            RenderFragment content = b =>
            {
                b.OpenElement(0, "RadzenRow");

                b.OpenElement(1, "RadzenColumn");
                b.AddAttribute(2, "Size", "12");

                b.AddContent(3, message);

                b.CloseElement();
                b.CloseElement();
            };
            return content;
        }, new DialogOptions() { ShowTitle = false, Style = "min-height:auto;min-width:auto;width:auto", CloseDialogOnEsc = false });
    }

    private BadgeStyle BadgeStyleControlTransporte(EstadoTurno estadoTurno) {

        switch(estadoTurno) {

            case EstadoTurno.Creado : return BadgeStyle.Warning;
            case EstadoTurno.Iniciado : return BadgeStyle.Info;
            case EstadoTurno.Completado : return BadgeStyle.Success;
            case EstadoTurno.Cancelado : return BadgeStyle.Danger;
            case EstadoTurno.None : return BadgeStyle.Light;
            default : return BadgeStyle.Light;
        }

    }

    private BadgeStyle BadgeStyleEstadoTraslado(EstadoTraslado estadoTraslado) {

        switch(estadoTraslado) {

            case EstadoTraslado.Completado : return BadgeStyle.Success;
            case EstadoTraslado.Programado : return BadgeStyle.Info;
            case EstadoTraslado.Asignado : return BadgeStyle.Warning;
            case EstadoTraslado.Cancelado : return BadgeStyle.Danger;
            case EstadoTraslado.None : return BadgeStyle.Light;
            default : return BadgeStyle.Light;
        }

    }

