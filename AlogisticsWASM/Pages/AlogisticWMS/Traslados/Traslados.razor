        await base.OnInitializedAsync();

        try 
        {

            _monitorControlTransporte = new MonitorCtrlTransporte();

            _consultaCtrlTransporte = new ConsultaCtrlTransporte();

            valEstadoTurno = 0;

            //_listEstadoTurno = Enum.GetValues(typeof(EstadoTurno)).Cast<EstadoTurno>();

            _listEstadoTurno = new SortedList<int, string>
            {
                { 0, "Ninguno" },
                { 1, "Creado" },
