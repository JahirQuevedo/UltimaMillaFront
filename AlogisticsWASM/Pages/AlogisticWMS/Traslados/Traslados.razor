    //IEnumerable<EstadoTurno> _listEstadoTurno;

    SortedList<int, string> _listEstadoTurno = new SortedList<int, string>
        {
            { 0, "Ninguno" },
            { 1, "Creado" },
            { 2, "Iniciado" }, 
