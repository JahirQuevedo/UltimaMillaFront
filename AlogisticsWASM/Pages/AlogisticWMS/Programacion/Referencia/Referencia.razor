    private bool ValidarDatos(MonitorReferencia monitorReferencia) {
        ////Console.WriteLine("-> Se validan datos de la Referencia");
        bool _validarDatos = true;
        string _mensaje = string.Empty;

        _mensaje = "Validar datos de la Referencia";

        if (!String.IsNullOrEmpty(monitorReferencia.Mercancias)) {
            ////Console.WriteLine("-> Se validan datos de la Referencia");
            if (monitorReferencia.Mercancias.Trim().Length.Equals(0)) {
                JSRuntime.InvokeVoidAsync("eval", $@"document.getElementById(""REF_MERCANCIAS"").focus()");
                ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Guardar Referencia", Detail = _mensaje, Duration = 4000 });
                _validarDatos = false;
            } 
        } else {
            _mensaje = "Favor de registra una descripción de la mercancía";
            JSRuntime.InvokeVoidAsync("eval", $@"document.getElementById(""REF_MERCANCIAS"").focus()");
            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Guardar Referencia", Detail = _mensaje, Duration = 4000 });
            _validarDatos = false;
        }

        if (monitorReferencia.IdCatAduana.Equals(0)) {
            _mensaje = "Favor de selecciona la Aduana de Despacho";
            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Guardar Referencia", Detail = _mensaje, Duration = 4000 });
            _validarDatos = false;

        }

        if (monitorReferencia.IdCliente.Equals(0)) {
            _mensaje = "Favor de selecciona el Cliente de la Operación";
            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Guardar Referencia", Detail = _mensaje, Duration = 4000 });
            _validarDatos = false;

        }

        return _validarDatos;

    }
    async void OnSubmit(MonitorReferencia monitorReferencia)
    {
        string _mensaje = String.Empty;
        isLoading = true;
        ////Console.WriteLine("-> OnSubmit model : " + JsonSerializer.Serialize(monitorReferencia));

        if (ValidarDatos(monitorReferencia)) {

            monitorReferencia.IdEmpresaLogin = 1;
            monitorReferencia.Folio = FolioReferencia;
            monitorReferencia.TipoMercancia = (TipoMercanciaInventario)valTipoMercancia;
            monitorReferencia.TipoOperacion = (TipoOperacionAduanera)valTipoOperacion;
            monitorReferencia.EstadoReferencia = (EstadoReferencia)valEstadoReferencia;

            monitorReferencia.FechaAlta = valFechaCaptura;
            if (monitorReferencia.IdReferencia.Equals(0)) {
                monitorReferencia.CRUDAction = ECRUDAction.Create;
            } else {
                monitorReferencia.CRUDAction = ECRUDAction.Update;
            }

            InvokeAsync(async () =>
            {

                var _resultBase = await _referenciaWMSService!.Guardar(monitorReferencia);

                if (_resultBase.Success) {
                    monitorReferencia.IdReferencia = _resultBase.Id;
                    monitorReferencia.Folio = _resultBase.Data.Folio;

                    referenciaSelected.Folio = _resultBase.Data.Folio; 
                    referenciaSelected.IdReferencia = _resultBase.Data.IdReferencia;
                    FolioReferencia = _resultBase.Data.Folio;
                    IdReferencia = _resultBase.Data.IdReferencia;
                    disabledBtnInventario = false;
                    disabledTipoOperacion = true;
                    ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "La Referencia, se guardo correctamente", Detail = _mensaje, Duration = 4000 });
                    
                } else {
                    _mensaje = _resultBase.MensajeRespuesta;
                    ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Guardar Referencia", Detail = _mensaje, Duration = 4000 });
                    
                }

                DialogService.Close();

             });

          //  await BusyDialog("Procesando ...");

        }

        await InvokeAsync(StateHasChanged);
        isLoading = false;
    }

