@page "/referencia-crear/{IdReferencia:int}"
@page "/referencia-crear"

@using ALOG.Modelos
@using ALOG.Enums
@using ALOG.Modelos.Modelos.Catalogos
@using ALOG.Modelos.Modelos.DTO.Respuestas
@using ALOGRepositorios.Services
@using System.Text.Json
@using ALOGRepositorios.Services.Catalogos.ICatalogos
@using AlogisticsWASM.Pages.AlogisticWMS.Programacion.Servicio
@using ALOGRepositorios.Services.Peticiones.IPeticiones;
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop

@inject IJSRuntime JSRuntime;

@inject NavigationManager navigationManager
@inject DialogService DialogService
@inject DialogService DialogServiceConfirm
@inject DialogService DialogServiceBuscarRerencia

@inject NotificationService NotificationService
@attribute [Authorize]

<script src="resources/js/general.js"></script>

<style>
    .rz-grid-table {
        width: unset;
    }

    .rz-button {
        text-transform: none !important;
    }

    .editable-list-container {
        padding: 20px;
        border: 1px solid #eee;
        border-radius: 4px;
        max-width: 700px;
        margin: 0 auto;
    }

    .add-item-section {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
    }

    .list-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        border-bottom: 1px solid #eee;
    }

    .item-content {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .item-id {
        font-size: 0.8rem;
        color: #666;
    }

    .item-text {
        margin-top: 0.2rem;
    }

    .item-actions {
        display: flex;
        margin-left: 1rem;
    }

    .edit-form {
        display: flex;
        align-items: center;
        width: 100%;
    }

    .edit-actions {
        display: flex;
        margin-left: 1rem;
    }

    .empty-list-message {
        display: flex;
        align-items: center;
        color: #666;
        padding: 10px;
        background-color: #f8f9fa;
        border-radius: 4px;
    }

    .ml-1 {
        margin-left: 0.25rem;
    }

    .ml-2 {
        margin-left: 0.5rem;
    }

    .mt-3 {
        margin-top: 1rem;
    }

    .mr-2 {
        margin-right: 0.5rem;
    }

</style>

<div class="content mt-10">
    @* 
    <h3>Referencia</h3>
    <RadzenButton Click=@(args => OnClick("Primary button")) Text="Primary" ButtonStyle="ButtonStyle.Primary" class="rz-background-color-danger" />
     *@
    @if (isLoading)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Wrap="FlexWrap.Wrap" class="rz-m-12" Gap="2rem">           
            <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large">
                <Template>Guardando</Template>
            </RadzenProgressBarCircular>
        </RadzenStack>
    }else{
    <RadzenTemplateForm Data=@referenciaSelected Submit="@((MonitorReferencia args) => { OnSubmit(args); })">
    <div class="row g-3 flex-between-end mb-3">
        <div class="col-6">
            <h2 class="mb-2">Referencia</h2>
            @* <h5 class="text-700 fw-semi-bold">Orders placed across your store</h5> *@
        </div>
        <div class="col-6 text-end">
            <RadzenButton Click=@(args => EliminarReferencia()) Text="Eliminar" Icon="delete" ButtonStyle="ButtonStyle.Primary" class="rz-background-color-base-400" />
            <RadzenButton Click=@(() => CancelarRegistroReferencia()) Text="Cerrar" Icon="cancel" ButtonStyle="ButtonStyle.Primary" class="rz-background-color-base-400" />
            <RadzenButton Click=@(() => OpenBuscarReferencia()) Text="Buscar Referencia..." Icon="search" ButtonStyle="ButtonStyle.Primary" class="rz-background-color-danger" />
            <RadzenButton Text="Guardar" Icon="save" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" class="rz-background-color-danger" />
        </div>
        <div class="col-12">
            @*  *@
            <div class="row">
                @*                 
                <div class="col-sm-6 col-md-4">
                    <RadzenLabel Text="T. Mercancía" Component="REF_TIPO_MERCANCIA" />
                    <RadzenDropDown @bind-Value=@valTipoOperacion ValueProperty="Key" 
                                                Placeholder="Seleccione Tipo de Mercancía"
                                                TextProperty="Value" Data=@listTipoMercancia Style="width: 100%; max-width: 400px;" 
                                                Name="REF_TIPO_MERCANCIA" />
                </div> *@

                <div class="col-sm-6 col-md-4">
                    <RadzenLabel Text="T. Operación" Component="REF_TIPO_OPERACION" />
                    <RadzenDropDown @bind-Value=@valTipoOperacion ValueProperty="Key" 
                                                Placeholder="Seleccione la Operación"
                                                Disabled=@disabledTipoOperacion
                                                TextProperty="Value" Data=@listTipoOperacion 
                                                Style="width: 100%;" 
                                                Name="REF_TIPO_OPERACION" />
                </div>
                <div class="col-sm-6 col-md-4">
                    <RadzenLabel Text="Fecha Captura" Component="REF_FECHA_CAPTURA" />
                    <RadzenDatePicker @bind-Value="referenciaSelected.FechaAlta" ParseInput="@ParseDate" Name="REF_FECHA_CAPTURA" 
                    Style="width: 100%;" Disabled="@disabledFCapturaReferencia"/>
                </div>
                <div class="col-sm-6 col-md-4">
                    <RadzenLabel Text="Aduana de Despacho" Component="REF_ADUANA_SECCION"/>
                                        <RadzenAutoComplete @bind-Value=@referenciaSelected.AduanaSeccion Data=@listaAduanaSeccion
                                            Name="REF_ADUANA_SECCION" Change=@OnChangeAduanaSeccion class="rz-text-uppercase"
                                            ValueProperty="@nameof(RespListarCoincidenciasDTO.Id)"
                                            TextProperty="@nameof(RespListarCoincidenciasDTO.RazonSocial)" 
                                            LoadData=@OnLoadDataAduanaSeccion Style="width: 100%; text-transform: capitalize;" 
                                            InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Aduana Sección" }})">
                                                <Template Context="respListarCoincidenciasDTO">
                                                    <b>@respListarCoincidenciasDTO.Acronimo:</b> @respListarCoincidenciasDTO.RazonSocial
                                                </Template>
                                        </RadzenAutoComplete>
                </div>
            </div>
            @*  *@
        </div>
    </div>
    <div class="row g-3 flex-between-end mb-5">
        <div class="col-12">
             <div class="row">
                <div class="col-sm-6 col-md-4">
                   <RadzenLabel Text="Folio Referencia" Component="REF_FOLIO_REFERENCIA" />
                   <RadzenTextBox Style="width: 100%;" Name="REF_FOLIO_REFERENCIA" 
                    @bind-Value="FolioReferencia"
                    Disabled="@disableFolioReferencia" />
                </div>
                
                <div class="col-sm-6 col-md-4">
                    <RadzenLabel Text="Estado" Component="REF_ESTADO_REFERENCIA" />
                    <RadzenDropDown @bind-Value=@valEstadoReferencia ValueProperty="Key" 
                                                Placeholder="Estado de la Referencia"
                                                TextProperty="Value" Data=@listEstadoReferencia Style="width: 100%;" 
                                                Name="REF_ESTADO_REFERENCIA"
                                                Disabled="@disabledEdoReferencia" />
                </div>
                <div class="col-sm-6 col-md-4">
                    &nbsp;
                </div>
            </div>
        </div>  
    </div>
    <div class="row g-3 flex-between-end mb-5">
        <div class="col-12">
            <RadzenTabs Change=@OnChangeTabReferencia SelectedIndex="0">
                    <Tabs>
                        <RadzenTabsItem Text="Detalle Referencia">
                            <RadzenStack>
                                <div class="row">
                                     <div class="col-sm-6 col-md-4">
                                        <RadzenLabel Text="Referencia Buque" Component="REF_VIAJE_BUQUE"/>
                                        <RadzenAutoComplete @bind-Value=@referenciaSelected.FolioViaje Data=@listaReferenciaBuque 
                                            Name="REF_VIAJE_BUQUE" Change=@OnChangeReferenciaBuque class="rz-text-uppercase"
                                            ValueProperty="@nameof(MonitorViaje.IdViaje)"
                                            TextProperty="@nameof(MonitorViaje.FolioViaje)" LoadData=@OnLoadDataReferenciaBuque Style="width: 100%; text-transform: capitalize;" 
                                            InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Referencia Buque" }})">
                                                <Template Context="monitorViaje">
                                                    <b>Referencia Buque:</b> @monitorViaje.ReferenciaBuque
                                                    <br />
                                                    <b>Folio Viaje:</b> @monitorViaje.FolioViaje
                                                    <br />
                                                    <b>Buque:</b> @monitorViaje.Barco.Nombre
                                                </Template>
                                        </RadzenAutoComplete>
                                    </div>
                                    <div class="col-sm-6 col-md-4">
                                        <RadzenLabel Text="Manifiesto Buque" Component="REF_MANIFIESTO_BUQUE"/>
                                        <RadzenTextBox Style="width: 100%;" Name="REF_MANIFIESTO_BUQUE" />
                                    </div>
                                    <div class="col-sm-6 col-md-4">
                                        <RadzenLabel Text="Fecha Entrada" Component="REF_FECHA_ENTRADA" />
                                        <RadzenDatePicker @bind-Value="referenciaSelected.FechaEntrada" Style="width: 100%;" ShowTime="true" ShowSeconds="true" HoursStep="1.5" MinutesStep="5" SecondsStep="10" DateFormat="dd/MM/yyyy HH:mm" Name="REF_FECHA_ENTRADA" />
                                    </div>
                                    
                                </div>
                                <div class="row">
                                    @* <div class="col-sm-6 col-md-4">
                                        <RadzenLabel Text="Puerto Origen/Destino" Component="REF_PUERTO_ORIGENDESTINO"/>
                                        <RadzenTextBox Style="width: 100%;" Name="REF_PUERTO_ORIGENDESTINO" />
                                    </div> *@
                                    <div class="col-sm-6 col-md-4">
                                        <RadzenLabel Text="Pais Origen/Destino" Component="REF_PAIS"/>
                                        <RadzenTextBox Style="width: 100%;" Name="REF_PAIS" />
                                    </div>
                                    <div class="col-sm-6 col-md-4">
                                        <RadzenLabel Text="Terminal Origen" Component="REF_TERMINAL_ORIGEN"/>
                                        <RadzenTextBox Style="width: 100%;" Name="REF_TERMINAL_ORIGEN" />
                                    </div>                                    
                                </div>
                                @* <div class="row">
                                    <div class="col-sm-6 col-md-4">
                                        <RadzenLabel Text="Booking BL" Component="REF_BOOKING_BL"/>
                                        <RadzenTextBox Style="width: 100%" Name="REF_BOOKING_BL" />
                                    </div>  
                                    <div class="col-sm-2 col-md-2 align-content-end">
                                        <RadzenButton Click=@(args => OnClick("Agregar button")) Text="Agregar" Icon="add" ButtonStyle="ButtonStyle.Primary" class="rz-background-color-base-400" />
                                    </div>                           
                                </div> *@
                                <div class="row">
                                    <div class="col-sm-6 col-md-4">
                                        <RadzenLabel Text="Booking BL" Component="REF_BOOKING_BL"/>
                                        <div class="editable-list-container">

                                            <div class="add-item-section">
                                                <RadzenTextBox @bind-Value="@newItemText" Placeholder="Ingrese el Booking BL" style="width: 250px;" Disabled="@(referenciaSelected.IdReferencia.Equals(0))" />
                                                <RadzenButton Click="@AddItem" Text="Agregar" Icon="add" ButtonStyle="ButtonStyle.Primary" class="ml-2" Disabled="@(!CanAddItem)" />
                                            </div>

                                        </div>
                                            @if (listaReferenciaBookingBLs.Any())
                                            {
                                                <RadzenDataList Data="@listaReferenciaBookingBLs" class="mt-3" Style="max-height: 400px; overflow-y: auto;">
                                                    <Template Context="monitorReferenciaBookingBL">
                                                        <div class="list-item">

                                                            @if (itemBeingEdited?.BookingBl == monitorReferenciaBookingBL.BookingBl)
                                                            {
                                                                <div class="edit-form">
                                                                    <RadzenTextBox @bind-Value="@editItemText" Style="width: 250px; margin-left: 0.5rem;" />
                                                                    <div class="edit-actions">
                                                                        <RadzenButton Click="@(() => SaveEdit(monitorReferenciaBookingBL))" 
                                                                                    Icon="save" 
                                                                                    ButtonStyle="ButtonStyle.Success" 
                                                                                    Size="ButtonSize.Small" />
                                                                        <RadzenButton Click="@CancelEdit" 
                                                                                    Icon="cancel" 
                                                                                    ButtonStyle="ButtonStyle.Secondary" 
                                                                                    Size="ButtonSize.Small" 
                                                                                    class="ml-2" />
                                                                    </div>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="item-content">
                                                                    <span class="item-text">@monitorReferenciaBookingBL.BookingBl</span>
                                                                </div>
                                                                <div class="item-actions">
                                                                    <RadzenButton Click="@(() => StartEdit(monitorReferenciaBookingBL))"
                                                                                Icon="edit" 
                                                                                ButtonStyle="ButtonStyle.Info" 
                                                                                Size="ButtonSize.Small" />
                                                                    <RadzenButton Click="@(() => RemoveItem(monitorReferenciaBookingBL))" 
                                                                                
                                                                                Icon="delete" 
                                                                                ButtonStyle="ButtonStyle.Danger" 
                                                                                Size="ButtonSize.Small" 
                                                                                class="ml-2" />
                                                                </div>
                                                            }
                                                        </div>
                                                    </Template>
                                                </RadzenDataList>
                                            }
                                            else
                                            {
                                                <div class="empty-list-message mt-3">
                                                    <RadzenIcon Icon="info" class="mr-2" />
                                                    <span>La lista está vacía. Agrega el Booking BL de la Referencia.</span>
                                                </div>
                                            }

                                        </div>
                                </div>
                            </RadzenStack>
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Mercancía">
                                <div class="row">
                                    <div class="col-sm-12 col-md-12">
                                        <RadzenSplitButton Click=@(args => OnClickSplitButton(args, "SplitButton with text and icon")) Text="Acciones Inventario" 
                                                ButtonStyle="ButtonStyle.Danger"
                                                Disabled="@disabledBtnInventario"
                                                Icon="lists">
                                            <ChildContent>
                                                <RadzenSplitButtonItem Text="Agregar Mercancía" Value="1" Icon="account_box" />
                                                <RadzenSplitButtonItem Text="Agregar Pretarja" Value="2" Icon="account_balance_wallet" />
                                            </ChildContent>
                                        </RadzenSplitButton>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6 col-md-6">
                                        <RadzenLabel Text="Mercancias" Component="REF_MERCANCIAS"/>
                                        <RadzenTextArea Style="width: 100%; background-color: antiquewhite;" aria-label="TextArea"
                                            @bind-Value="referenciaSelected.Mercancias"
                                         Name="REF_MERCANCIAS" />
                                    </div>                                    
                                    <div class="col-sm-6 col-md-6">
                                        <RadzenLabel Text="Observaciones" Component="REF_OBSERVACIONES"/>
                                        <RadzenTextArea Style="width: 100%" aria-label="TextArea" 
                                        @bind-Value="referenciaSelected.Observaciones"
                                        Name="REF_OBSERVACIONES" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6 col-md-6">
                                        <RadzenFieldset Text="Inicial">
                                            <div class="row">
                                                <div class="col-sm-6 col-md-6">
                                                    <RadzenLabel Text="Cantidad" Component="REF_BULTO_INICIAL"/>
                                                    <RadzenNumeric Name="REF_BULTO_INICIAL" TValue="int" Style="width: 100%; background-color: antiquewhite;" ShowUpDown="false" @bind-Value="referenciaSelected.BultosInical" InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "enter value" }})" />
                                                </div>                                    
                                                <div class="col-sm-6 col-md-6">
                                                    <RadzenLabel Text="Peso (Kg)" Component="REF_PESO_INICIAL"/>
                                                    <RadzenNumeric Name="REF_PESO_INICIAL" TValue="decimal" Format="#.000" Style="width: 100%; background-color: antiquewhite;" ShowUpDown="false" @bind-Value="referenciaSelected.PesoInicial" InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "enter value" }})" />
                                                </div>
                                            </div>
                                        </RadzenFieldset>
                                    </div>
                                    <div class="col-sm-6 col-md-6">
                                        <RadzenFieldset Text="Final">
                                            <div class="row">
                                                <div class="col-sm-6 col-md-6">
                                                    <RadzenLabel Text="Cantidad" Component="REF_BULTO_FINAL"/>
                                                    <RadzenNumeric Name="REF_BULTO_FINAL" Disabled="@disabledCompentReferencia" TValue="int" Style="width: 100%; background-color: antiquewhite;" ShowUpDown="false" @bind-Value="referenciaSelected.BultosFinal" InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "enter value" }})" />
                                                </div>                                    
                                                <div class="col-sm-6 col-md-6">
                                                    <RadzenLabel Text="Peso" Component="REF_PESO_FINAL"/>
                                                    <RadzenNumeric Name="REF_PESO_FINAL" Disabled="@disabledCompentReferencia" TValue="decimal" Style="width: 100%; background-color: antiquewhite;" Format="#.000" ShowUpDown="false" @bind-Value="referenciaSelected.PesoFinal" InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "enter value" }})" />
                                                </div>
                                            </div>
                                        </RadzenFieldset>
                                    </div>
                                </div>
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Información Administrativa">
                            <RadzenStack>
                                <div class="row">
                                    @* <div class="col-sm-6 col-md-2">
                                        <RadzenLabel Text="Clave" Component="REF_CLAVE_CLIENTE"/>
                                        <RadzenTextBox Style="width: 100%" Name="REF_CLAVE_CLIENTE" />
                                    </div> *@
                                    <div class="col-sm-6 col-md-6">
                                        <RadzenLabel Text="Cliente" Component="REF_RAZONSOCIAL_CLIENTE"/>
                                        <RadzenAutoComplete @bind-Value=@referenciaSelected.Cliente Data=@listaCliente
                                            Name="REF_RAZONSOCIAL_CLIENTE" Change=@OnChangeCliente class="rz-text-uppercase"
                                            ValueProperty="@nameof(RespListarCoincidenciasDTO.Id)"
                                            TextProperty="@nameof(RespListarCoincidenciasDTO.RazonSocial)" LoadData=@OnLoadDataCliente Style="width: 100%; text-transform: capitalize;" 
                                            InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Cliente" }})" />
                                    </div>                                    
                                </div>
                                <div class="row">
                                    @* <div class="col-sm-6 col-md-2">
                                        <RadzenLabel Text="" Component="REF_CLAVE_FACTURARA"/>
                                        <RadzenTextBox Style="width: 100%;" Name="REF_CLAVE_FACTURARA" />
                                    </div> *@
                                    <div class="col-sm-6 col-md-6">
                                        <RadzenLabel Text="Facturar A" Component="REF_RAZONSOCIAL_FACTURARA"/>
                                        <RadzenAutoComplete @bind-Value=@referenciaSelected.FacturarA Data=@listaFacturarA
                                            Name="REF_RAZONSOCIAL_FACTURARA" Change=@OnChangeFacturarA class="rz-text-uppercase"
                                            ValueProperty="@nameof(RespListarCoincidenciasDTO.Id)"
                                            TextProperty="@nameof(RespListarCoincidenciasDTO.RazonSocial)" LoadData=@OnLoadDataFacturarA Style="width: 100%; text-transform: capitalize;" 
                                            InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Facturar A" }})" />
                                    </div>                                    
                                </div>
                                <div class="row">
                                    @* <div class="col-sm-6 col-md-2">
                                        <RadzenLabel Text="" Component="REF_CLAVE_PROVEEDOR"/>
                                        <RadzenTextBox Style="width: 100%;" Name="REF_CLAVE_PROVEEDOR" />
                                    </div> *@
                                    <div class="col-sm-6 col-md-6">
                                        <RadzenLabel Text="Proveedor / Destinatario" Component="REF_RAZONSOCIAL_PROVEEDOR"/>
                                        <RadzenAutoComplete @bind-Value=@referenciaSelected.ProveedorDest Data=@listaProveedorDestinatario
                                            Name="REF_RAZONSOCIAL_PROVEEDOR" Change=@OnChangeProveedorDestinatario class="rz-text-uppercase"
                                            ValueProperty="@nameof(RespListarCoincidenciasDTO.Id)"
                                            TextProperty="@nameof(RespListarCoincidenciasDTO.RazonSocial)" LoadData=@OnLoadDataProveedorDestinatario Style="width: 100%; text-transform: capitalize;" 
                                            InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Proveedor / Destinatario" }})" />
                                    </div>                                    
                                </div>
                                <div class="row">
                                    @* <div class="col-sm-6 col-md-2">
                                        <RadzenLabel Text="" Component="REF_CLAVE_IMPOEXPO"/>
                                        <RadzenTextBox Style="width: 100%;" Name="REF_CLAVE_IMPOEXPO" />
                                    </div> *@
                                    <div class="col-sm-6 col-md-6">
                                        <RadzenLabel Text="Importador / Exportador" Component="REF_RAZONSOCIAL_IMPOEXPO"/>
                                        <RadzenTextBox Style="width: 100%;" Name="REF_RAZONSOCIAL_IMPOEXPO" />
                                    </div>                                    
                                </div>
                            </RadzenStack>
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Inventario">
                            <RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                                <RadzenRow JustifyContent="JustifyContent.Normal" class="rz-my-2">
                                    <RadzenColumn Size="2" class="text-start">
                                    <RadzenSplitButton Click=@(args => OnClickSplitButtonInventario(args, "Acciones Servicios")) Text="Acciones" 
                                            ButtonStyle="ButtonStyle.Danger"
                                            Disabled="@disabledBtnInventario"
                                            Icon="lists">
                                        <ChildContent>
                                            <RadzenSplitButtonItem Text="Agregar Servicio Tarja" Value="1" Icon="home_repair_service" />
                                             <RadzenSplitButtonItem Text="Agregar Servicio Partida" Value="2" Icon="home_repair_service" />
                                        </ChildContent>
                                    </RadzenSplitButton>
                                    </RadzenColumn>
                                    <RadzenColumn Size="10" class="text-start align-content-center">
                                        @if (!totalRegistrosInventario.Equals(0)) {
                                            <RadzenText TextStyle="TextStyle.H5">No. Tarja (@totalRegistrosInventario)</RadzenText>
                                        }
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenStack>
                            <RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.Center" Style="height: 100%;">
                                                             
                                <RadzenDataGrid class="rz-p-4"
                                            @ref="gridTarjaInventario"
                                            Count="@totalRegistrosInventario" PageSize="@registrosPorPaginaInventario" ShowPagingSummary="true" 
                                            SelectionMode="DataGridSelectionMode.Multiple"
                                            PagerHorizontalAlign="HorizontalAlign.Left"
                                            @bind-Value=@selectedTarjaInventario
                                            style="border-radius:7px;"
                                            AllowFiltering="false" AllowPaging="true" AllowSorting="false" 
                                            FilterPopupRenderMode="PopupRenderMode.OnDemand" 
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            Data="@(listaMonitorTarjasInventario)" LoadData="@ObtenerDatosInventario"  
                                            IsLoading=@isLoadingInventario ColumnWidth="200px" 
                                            TItem="MonitorTarja"
                                            RowExpand="RowExpandTarjaInventario"
                                            RowRender="@RowRenderTarjaInventario"
                                            ExpandMode="DataGridExpandMode.Single"
                                            Density="Density.Compact" AllowAlternatingRows="false">
                                    @* ----------------------------------------------------------------------------------------------------------- *@
                                    <Template Context="monitorTarja">
                                        <RadzenDataGrid AllowFiltering="false" AllowPaging="true" AllowSorting="false" 
                                            style="border-radius:7px; width: 100%;"
                                            @ref="gridMonitorPartidaInventario"
                                            PagerHorizontalAlign="HorizontalAlign.Left"
                                            SelectionMode="DataGridSelectionMode.Multiple"
                                            AllowColumnResize="true"
                                            ColumnWidth="200px"
                                            Count="@totalRegistrosPartidaInventario" 
                                            PageSize="@registrosPorPaginaPartidaInventario" ShowPagingSummary="true" 
                                            LoadData="@ObtenerDatosTarjaInventario"
                                            @bind-Value=@selectedPartidaInventario
                                            Data="@listaMonitorPartidaInventario">
                                            <Columns>
                                                <RadzenDataGridColumn Width="35px" Sortable="false" Filterable="false"  Frozen="true">
                                                    <HeaderTemplate>
