    private async void AddItem()
    {
        if (!string.IsNullOrWhiteSpace(newItemText))
        {
            var _existeItem = listaReferenciaBookingBLs.Where(p => p.BookingBl.Equals(newItemText)).Any();

            if (!_existeItem) {

                InvokeAsync(async () =>
                {
                    
                    //items.Add(newItem.Trim());
                    MonitorReferenciaBookingBL _referenciaBookingBL = new MonitorReferenciaBookingBL();
                    _referenciaBookingBL.IdReferencia = referenciaSelected.IdReferencia;
                    _referenciaBookingBL.BookingBl = newItemText;
                    _referenciaBookingBL.CRUDAction = ECRUDAction.Create;

                    var _result = await _referenciaBookingBLService.Guardar(_referenciaBookingBL);

                    if (_result.Success) {

                        listaReferenciaBookingBLs.Add(_referenciaBookingBL);

                    }
                    
                    newItemText = string.Empty;
                    
                    DialogService.Close();

                    await InvokeAsync(StateHasChanged);

                });

                await BusyDialog("Guardando Información...");

            }

        }
    }

    private async void RemoveItem(MonitorReferenciaBookingBL itemToRemove)
    {
        //items.Remove(itemToRemove.BookingBl);

        var _existeItem = listaReferenciaBookingBLs.Where(p => p.BookingBl.Equals(itemToRemove.BookingBl)).Any();

        if (_existeItem) {

            InvokeAsync(async () =>
            {

                var _resultBase = await _referenciaBookingBLService.Eliminar(itemToRemove.IdReferenciaBookingBl);

                if (_resultBase.Success) {

                    listaReferenciaBookingBLs.RemoveAll(p => p.BookingBl.Equals(itemToRemove.BookingBl) && p.IdReferenciaBookingBl.Equals(itemToRemove.IdReferenciaBookingBl));

                }

                DialogService.Close();

                await InvokeAsync(StateHasChanged);

            });

            await BusyDialog("Procesando Solicitud...");

        }
    }

    private void StartEdit(MonitorReferenciaBookingBL item)
    {
        itemBeingEdited = item;
        editItemText = item.BookingBl;
        editItemId = item.IdReferenciaBookingBl;
    }

    private async void SaveEdit(MonitorReferenciaBookingBL originalItem)
    {
        if (itemBeingEdited != null && editItemId.HasValue && !string.IsNullOrWhiteSpace(editItemText))
        {

             var _existeItem = listaReferenciaBookingBLs.Where(p => p.BookingBl.Equals(editItemText)).Any();

            if (!_existeItem) {

                InvokeAsync(async () =>
                {

                    originalItem.BookingBl = editItemText.Trim();
                    originalItem.CRUDAction = ECRUDAction.Update;

                    var _result = await _referenciaBookingBLService.Guardar(originalItem);

                    DialogService.Close();

                    await InvokeAsync(StateHasChanged);

                });

                await BusyDialog("Procesando Solicitud...");

                
            } else if (!editItemText.Equals(originalItem.BookingBl)) {
                
                ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Referencia Booking BL", Detail = "Ya se encuentra registrado el Booking BL en la Referencia.", Duration = 4000 });

            }

            CancelEdit();
        }
    }

    private void CancelEdit()
    {
        itemBeingEdited = null;
        editItemText = string.Empty;
        editItemId = null;
    }

    private string obtenerTipoServicio(TipoServicioTarja tipoServicioTarja) 
    {

        string _tipoServicio = String.Empty;

        switch(tipoServicioTarja) {
            case TipoServicioTarja.EntradaAlmacen :
                _tipoServicio = "Entrada de Almacén";
                break;
            case TipoServicioTarja.EntradaPorTransferencia :
                _tipoServicio = "Entrada Por Transferencia";
                break;
            case TipoServicioTarja.EntradaPatioExterno :
                _tipoServicio = "Entrada Patio Externo";
                break;
            default : 
                _tipoServicio = tipoServicioTarja.ToString();
                break;

        }

        return _tipoServicio;

    }

    private BadgeStyle BadgeStyleEstadoTarja(EstadoTarja estadoTarja) {

        switch(estadoTarja) {

            case EstadoTarja.Confirmado : return BadgeStyle.Success;
            case EstadoTarja.Preliminar: return BadgeStyle.Warning;
            case EstadoTarja.Cancelado : return BadgeStyle.Danger;
            case EstadoTarja.None : return BadgeStyle.Light;
            default : return BadgeStyle.Light;
        }

    }

    @* ------------------------------------------------------------------------------------------------------------------ *@

    void OnDrag(System.Drawing.Point point)
    {
        JSRuntime.InvokeVoidAsync("eval", $"console.log('Dialog drag. Left:{point.X}, Top:{point.Y}')");

        if(Settings == null)
        {
            Settings = new DialogSettings();
        }

        Settings.Left = $"{point.X}px";
        Settings.Top = $"{point.Y}px";

        InvokeAsync(SaveStateAsync);
    }

    void OnResize(System.Drawing.Size size)
    {
        JSRuntime.InvokeVoidAsync("eval", $"console.log('Dialog resize. Width:{size.Width}, Height:{size.Height}')");

        if(Settings == null)
        {
            Settings = new DialogSettings();
        }

        Settings.Width = $"{size.Width}px";
        Settings.Height = $"{size.Height}px";

        InvokeAsync(SaveStateAsync);
    }
    public DialogSettings Settings 
    { 
        get
        {
            return _settings;
        }
        set
        {
            if (_settings != value)
            {
                _settings = value;
                InvokeAsync(SaveStateAsync);
            }
        }
    }

    private async Task LoadStateAsync()
    {
        await Task.CompletedTask;

        var result = await JSRuntime.InvokeAsync<string>("window.localStorage.getItem", "DialogSettings");
        if (!string.IsNullOrEmpty(result))
        {
            _settings = JsonSerializer.Deserialize<DialogSettings>(result);
        }
    }

    private async Task SaveStateAsync()
    {
        await Task.CompletedTask;

        await JSRuntime.InvokeVoidAsync("window.localStorage.setItem", "DialogSettings", JsonSerializer.Serialize<DialogSettings>(Settings));
    }

    public class DialogSettings
    {
        public string Left { get; set; }
        public string Top { get; set; }
        public string Width { get; set; }
        public string Height { get; set; }
    }

