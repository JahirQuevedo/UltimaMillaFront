    private ResultBase ValidarMonitorTarjaSelected(ServicioAplicado _servicioPara)
    {
        string _mensaje = "Favor de Seleccionar al menos un elemento del Inventario";

        ResultBase _resultBase = new ResultBase();

        if (_servicioPara.Equals(ServicioAplicado.Tarja)) {

            if (selectedTarjaInventario == null) {
                _resultBase.MensajeRespuesta = _mensaje;
            } else {
                if (selectedTarjaInventario.Count.Equals(0)) {
                    _resultBase.MensajeRespuesta = _mensaje;
                }
            }

        } else if (_servicioPara.Equals(ServicioAplicado.Inventario)) {

            if (selectedPartidaInventario == null) {
                _resultBase.MensajeRespuesta = _mensaje;
            } else {
                if (selectedPartidaInventario.Count.Equals(0)) {
                    _resultBase.MensajeRespuesta = _mensaje;
                }
            }

        }

        return _resultBase;

    }

