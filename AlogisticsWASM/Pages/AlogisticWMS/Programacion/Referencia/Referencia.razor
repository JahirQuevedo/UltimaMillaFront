    async Task EliminarReferencia() {

        string _mensaje = String.Empty;
        bool _accionEliminar = false;

        if (referenciaSelected != null) {

            if (!referenciaSelected.IdReferencia.Equals(0)) 
            {

                _accionEliminar = true;

                var result = await DialogServiceConfirm.Confirm("Desea Eliminar la Referencia?", "Referencia", new ConfirmOptions() { OkButtonText = "Si", CancelButtonText = "No" });

                bool _confirmar = result.HasValue ? (bool)result : false;

                if (_confirmar) {

                    var _result = await _referenciaWMSService.Eliminar(referenciaSelected.IdReferencia);

                    if (_result.Success) {

                        ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "La Referencia, se eliminó correctamente", Detail = _mensaje, Duration = 4000 });
                        await CancelarRegistroReferencia();

                    } else {

                        _mensaje = _result.MensajeRespuesta;
                        ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Eliminar Referencia", Detail = _mensaje, Duration = 4000 });

                    }

                }

            }

        }

        if (!_accionEliminar) {

            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Eliminar Referencia", 
                Detail = "No existe Referencia seleccionada", Duration = 4000 });

        }


    }

