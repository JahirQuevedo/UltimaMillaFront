    private async Task LoadStateAsync()
    {
        await Task.CompletedTask;

        var result = await JSRuntime.InvokeAsync<string>("window.localStorage.getItem", "DialogSettings");
        if (!string.IsNullOrEmpty(result))
        {
            _settings = System.Text.Json.JsonSerializer.Deserialize<DialogSettings>(result);
        }

        var resultIdReferencia = await JSRuntime.InvokeAsync<string>("window.localStorage.getItem", "IdReferencia");
        if (!string.IsNullOrEmpty(result))
        {
            IdReferencia = System.Text.Json.JsonSerializer.Deserialize<int>(resultIdReferencia);
        }

        var resultMonitorFolioServicio = await JSRuntime.InvokeAsync<string>("window.localStorage.getItem", "MonitorFolioServicio");
        if (!string.IsNullOrEmpty(resultMonitorFolioServicio))
        {
            monitorFolioServicio = System.Text.Json.JsonSerializer.Deserialize<MonitorFolioServicio>(resultMonitorFolioServicio);
        }

        var resultRelacionInventarioServicio = await JSRuntime.InvokeAsync<string>("window.localStorage.getItem", "RelacionInventarioServicio");
        if (!string.IsNullOrEmpty(resultRelacionInventarioServicio))
        {
            listaRelacionInventarioServicioSelected = System.Text.Json.JsonSerializer.Deserialize<List<RelacionInventarioServicio>>(resultRelacionInventarioServicio);
        }
    }

    private async Task SaveStateAsync()
    {
        await Task.CompletedTask;

        await JSRuntime.InvokeVoidAsync("window.localStorage.setItem", "DialogSettings", System.Text.Json.JsonSerializer.Serialize<DialogSettings>(Settings));
        await JSRuntime.InvokeVoidAsync("window.localStorage.setItem", "IdReferencia", System.Text.Json.JsonSerializer.Serialize<int>(IdReferencia));
        await JSRuntime.InvokeVoidAsync("window.localStorage.setItem", "MonitorFolioServicio", System.Text.Json.JsonSerializer.Serialize<MonitorFolioServicio>(monitorFolioServicio));
        await JSRuntime.InvokeVoidAsync("window.localStorage.setItem", "RelacionInventarioServicio", System.Text.Json.JsonSerializer.Serialize<List<RelacionInventarioServicio>>(listaRelacionInventarioServicioSelected));
    }

    public class DialogSettings
