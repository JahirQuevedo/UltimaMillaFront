    public async Task ConfirmarServicio(MonitorFolioServicio monitorFolioServicio) {

        string _mensaje = String.Empty;
        bool _accionConfirmar = false;

        if (monitorFolioServicio != null) {

            if (!monitorFolioServicio.IdFolioServicio.Equals(0)) 
            {

                if (monitorFolioServicio.EstadoFolioServicio.Equals(EstadoFolioServicio.Pendiente)) {

                    _accionConfirmar = true;

                    var result = await DialogServiceConfirm.Confirm("Desea Confirmar el Servicio?", "Servicio " + monitorFolioServicio.Folio.ToString(), new ConfirmOptions() { OkButtonText = "Si", CancelButtonText = "No" });

                    bool _confirmar = result.HasValue ? (bool)result : false;

                    if (_confirmar) {

                        var _result = await _folioServicioService.Confirmar(monitorFolioServicio.IdFolioServicio);

                        if (_result.Success) {

                            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "El Servicio, se confirmó correctamente", Detail = _mensaje, Duration = 4000 });
                            

                        } else {

                            _mensaje = _result.MensajeRespuesta;
                            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Confirmar Servicio", Detail = _mensaje, Duration = 4000 });

                        }

                    } 

                } else {

                    ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Confirmar Servicio", Detail = "El Servicio se encuentra actualmente confirmado", Duration = 4000 });

                }

            } 

        }


    }

