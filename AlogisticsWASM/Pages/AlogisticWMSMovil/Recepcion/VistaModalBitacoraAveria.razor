@code {

    RadzenDataGrid<MonitorBitacoraAveria> gridBitacoraAveria;

    [Parameter] public int IdInventario { get; set; }

    [Parameter] public bool ShowClose { get; set; } = true;

    bool permitirVirtualization = true;

    MonitorBitacoraAveria monitorBitacoraAveria;

    List<MonitorBitacoraAveria> listaMonitorBitacoraAveria;

    IList<MonitorBitacoraAveria> selectedBitacoraAveria;

    private LoadDataArgs _args;

    bool isLoading = false;

    int totalRegistros;

    int registrosPorPagina = 5;

    int numeroDePagina = 1;

    [Inject] private IBitacoraAveriaService?  _bitacoraAveriaService { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        

        monitorBitacoraAveria = new MonitorBitacoraAveria();

        listaMonitorBitacoraAveria = new List<MonitorBitacoraAveria>();

        monitorBitacoraAveria.IdInventario = IdInventario;

        permitirVirtualization = false;

        await ObtenerDatos(_args);

    }

    private async Task ObtenerDatos(LoadDataArgs args) {

        isLoading = true;

        //await JSRuntime.InvokeVoidAsync("window.localStorage.setItem", "DialogSettings", JsonSerializer.Serialize<DialogSettings>(Settings));

        

        ConsultaCatalogoBase<ConsultaBitacoraAveria> _consulta = new ConsultaCatalogoBase<ConsultaBitacoraAveria>();
        _consulta.Entidad = new ConsultaBitacoraAveria();
        _consulta.Entidad.IdInventario = IdInventario;

        if (args != null) {
            numeroDePagina = ((int)args.Skip/registrosPorPagina) + 1;
        }

        _consulta.NumeroDePagina = numeroDePagina;
        _consulta.RegistrosPorPagina = registrosPorPagina;

        var _listBitacoraAverias = await _bitacoraAveriaService!.ObtenerListaPaginadaPorIdInventario(_consulta);

        if (!_listBitacoraAverias.Data.Count.Equals(0)) {

            

            totalRegistros = (int)_listBitacoraAverias.Paginado.TotalRegistros;

            

            listaMonitorBitacoraAveria = _listBitacoraAverias.Data;

            //selectedBitacoraAveria = listaMonitorBitacoraAveria.Take(1).ToList();

        } else {

            dialogService.Close(true);
            
        }

        isLoading = false;

    }

    private async void EliminarBitacoraAveria(MonitorBitacoraAveria _monitorBitacoraAveria) {
        var result = await _bitacoraAveriaService?.Eliminar(_monitorBitacoraAveria.IdBitacoraAveria);

        if (result.Success) {

            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Bitácora Averia", Detail = "Registro Eliminado:" + result.MensajeRespuesta, Duration = 4000 });

            await ObtenerDatos(_args);

            await InvokeAsync(StateHasChanged);

        } else {

            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Bitácora Averia", Detail = "Error: " + result.MensajeRespuesta, Duration = 4000 });

        }
    }

    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);
        
    }

}
