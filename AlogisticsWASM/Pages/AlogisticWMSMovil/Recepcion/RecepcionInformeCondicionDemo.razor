@code {
    private string ImagePath = "img/automovil-informe/automovil-informe-condicion-top.jpg";
    private List<Marker> Markers = new();
    private bool ImageLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadCanvas();
        }
    }

    private async Task LoadCanvas()
    {
        await JSRuntime.InvokeVoidAsync("loadImageOnCanvas", ImagePath);
        ImageLoaded = true;
    }

    private async Task AddMarker(MouseEventArgs e)
    {
        if (!ImageLoaded) return;
        
        string label = $"Punto {Markers.Count}";
        Markers.Add(new Marker { X = (int)e.OffsetX, Y = (int)e.OffsetY, Label = label });
        await JSRuntime.InvokeVoidAsync("drawMarkerWithLabel", e.OffsetX, e.OffsetY, label);
    }

    private async Task RemoveMarker(int index)
    {
        if (index >= 0 && index < Markers.Count)
        {
            Markers.RemoveAt(index);
            await JSRuntime.InvokeVoidAsync("redrawCanvas", ImagePath, Markers);
        }
    }

    private async Task ClearMarkers()
    {
        Markers.Clear();
        await JSRuntime.InvokeVoidAsync("redrawCanvas", ImagePath, Markers);
    }

    private async Task SaveImage()
    {
        await JSRuntime.InvokeVoidAsync("saveCanvasImage");
    }

    private async Task SendImageToAPI()
    {
        var base64Image = await JSRuntime.InvokeAsync<string>("getCanvasBase64");
        
        var httpClient = new HttpClient();
        var content = new StringContent(System.Text.Json.JsonSerializer.Serialize(new { image = base64Image }), System.Text.Encoding.UTF8, "application/json");
        
        var response = await httpClient.PostAsync("https://tu-api.com/upload", content);
        
        if (response.IsSuccessStatusCode)
        {
            ////Console.WriteLine("Imagen enviada correctamente");
        }
        else
        {
            ////Console.WriteLine("Error al enviar la imagen");
        }
    }

    private class Marker
    {
        public int X { get; set; }
        public int Y { get; set; }
        public string Label { get; set; } = string.Empty;
    }
}