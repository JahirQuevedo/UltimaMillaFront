@code {

    [Parameter] public string DataRecepcion { get; set; }

    MonitorPartida monitorPartida = new MonitorPartida();

    List<MonitorPartida> listaMonitorPartida = new List<MonitorPartida>();

    List<MonitorRecepcionMercancia> _listaMonitorRecepcionMercancia = new List<MonitorRecepcionMercancia>();

    MonitorRecepcionMercancia _monitorRecepcionMercancia = new MonitorRecepcionMercancia();

    RecepcionMercanciaDTO _recepcionMercanciaDTO = new RecepcionMercanciaDTO();

   int valEstadoRecepcion = 1;

    bool permiteVirtualization = false;
    int count;

    bool disabledTieneAveria = true;

    bool isLoading;

    int registrosPorPagina = 50;

    int totalRegistros;

    int numeroDePagina = 1;

    LoadDataArgs _args;

    [Inject] private IRecepcionService? _recepcionService { get; set; } 

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _listaMonitorRecepcionMercancia = new List<MonitorRecepcionMercancia>();

        await LoadStateRecepcionAsync();

        _monitorRecepcionMercancia =  new MonitorRecepcionMercancia();

        _monitorRecepcionMercancia = _listaMonitorRecepcionMercancia.Take(1).SingleOrDefault();

        ////Console.WriteLine("OnInitializedAsync");

    }

    protected override async void OnParametersSet()
    {

        ////Console.WriteLine("OnParametersSet");

        if (DataRecepcion != null) {

            byte[] binaryData = Convert.FromBase64String(DataRecepcion);
            string decodedString = System.Text.Encoding.UTF8.GetString(binaryData);

            ////Console.WriteLine("Decoded: " + decodedString);

            _recepcionMercanciaDTO =  new RecepcionMercanciaDTO();

            _recepcionMercanciaDTO = JsonConvert.DeserializeObject<RecepcionMercanciaDTO>(decodedString);

            await LoadData(_args);

            //await LoadData(_args);

            @* await LoadStateRecepcionAsync();

            _monitorRecepcionMercancia =  new MonitorRecepcionMercancia();

            _monitorRecepcionMercancia = _listaMonitorRecepcionMercancia.Take(1).SingleOrDefault();

            totalRegistros = _listaMonitorRecepcionMercancia.Count; *@

        }

    }

    private string ObtenerFechaEnFormato(DateTime _fecha, string _formatoFecha) {

        return _fecha.Equals(DateTime.MinValue) ? null : _fecha.ToString("dd-MM-yyyy HH:mm:ss");

    }

    public async Task ConfirmarTarjaRecepcionMercancia()
    {

        ConsultaCatalogoBase<ConsultaRecepcion> _consultaRecepcion = new ConsultaCatalogoBase<ConsultaRecepcion>();
        _consultaRecepcion.Entidad = new ConsultaRecepcion();
        _consultaRecepcion.Entidad.IdTarja = _recepcionMercanciaDTO.IdTarja;

        var _result = await _recepcionService.ConfirmarRecepcionMercanciaPorIdTarja(_consultaRecepcion);

        if (_result.Success) {

            _listaMonitorRecepcionMercancia = _result.Data;

            await SaveStateRecepcionAsync();

        } else {

            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Recepción", Detail = "Error al confirmar la Tarja de Recepción.", Duration = 4000 });

        }

    }

    private async void OnConfirmarRecoleccionInventario(MonitorRecepcionMercancia monitorRecepcionMercancia) {


        ConsultaCatalogoBase<ConsultaRecepcion> _consultaRecepcion = new ConsultaCatalogoBase<ConsultaRecepcion>();
        _consultaRecepcion.Entidad = new ConsultaRecepcion();

        _consultaRecepcion.Entidad.IdInventario = monitorRecepcionMercancia.IdInventario;
        _consultaRecepcion.Entidad.TieneAveria = monitorRecepcionMercancia.TieneAveria;

        ////Console.WriteLine("-> OnConfirmarRecoleccionInventario _consultaRecepcion : " + System.Text.Json.JsonSerializer.Serialize(_consultaRecepcion));

        var _result = await _recepcionService.ConfirmarRecepcionMercanciaPorIdPartidaInventario(monitorRecepcionMercancia.IdInventario, monitorRecepcionMercancia.TieneAveria ? 1 : 0);

        if (_result.Success) {

            var index = _listaMonitorRecepcionMercancia.FindIndex(x => x.Equals(monitorRecepcionMercancia.IdInventario));

            if (index != -1)
            {
                _listaMonitorRecepcionMercancia[index].FechaRecoleccion = _result.Data.FechaRecoleccion;
            }

            await LoadData(_args);

            await SaveStateRecepcionAsync();

        } else {

            ShowNotification(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Recepción", Detail = "Error al confirmar la mercancía.", Duration = 4000 });

        }


    }

    private async void OnIngresarMercancia(MonitorRecepcionMercancia monitorRecepcionMercancia) {

        RecepcionMercanciaDTO recepcionMercanciaDTO = new RecepcionMercanciaDTO();

        _recepcionMercanciaDTO.IdMercancia = monitorRecepcionMercancia.IdMercancia;
        _recepcionMercanciaDTO.IdInventario = monitorRecepcionMercancia.IdInventario;
        _recepcionMercanciaDTO.IdTarja = monitorRecepcionMercancia.IdTarja;

        string _monitorRecepcionMercanciaDTO = System.Text.Json.JsonSerializer.Serialize(_recepcionMercanciaDTO);

        await SaveStateAsync();

        byte[] binaryData = System.Text.Encoding.UTF8.GetBytes(_monitorRecepcionMercanciaDTO);
        string base64EncodedData = Convert.ToBase64String(binaryData);

        navigationManager.NavigateTo($"/recepcion-reportdannios/{base64EncodedData}");

    }

    async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;

        ////Console.WriteLine("LoadData");

        ConsultaCatalogoBase<ConsultaRecepcion> _consultaRecepcion = new ConsultaCatalogoBase<ConsultaRecepcion>();
        _consultaRecepcion.Entidad = new ConsultaRecepcion();
        _consultaRecepcion.Entidad.TipoClasificacionRecepcion = (TipoClasificacionRecepcion)valEstadoRecepcion;

        if (args != null) {
            numeroDePagina = ((int)args.Skip/registrosPorPagina) + 1;
        }

        _consultaRecepcion.NumeroDePagina = numeroDePagina;
        _consultaRecepcion.RegistrosPorPagina = registrosPorPagina;

        if (_recepcionMercanciaDTO.TipoBusquedaRecepcion.Equals(TipoBusquedaRecepcion.Tarja)) {

            _consultaRecepcion.Entidad.ClaveReferenciaTarja = _recepcionMercanciaDTO.ClaveReferenciaTarja;

        } else if (_recepcionMercanciaDTO.TipoBusquedaRecepcion.Equals(TipoBusquedaRecepcion.Partida)) {

            _consultaRecepcion.Entidad.IdMercancia = _recepcionMercanciaDTO.IdMercancia;

        }

        var _result = await _recepcionService.ObtenerListaPaginada(_consultaRecepcion);

        if (_result.Success) {

            if (!_result.Data.Count.Equals(0)) {

                _listaMonitorRecepcionMercancia = _result.Data;

                var _recepcionMercancia = _listaMonitorRecepcionMercancia.Take(1).SingleOrDefault();

                if (_recepcionMercancia != null) {

                    if (_recepcionMercancia.RecoleccionTarjaConfirmada) {

                        disabledTieneAveria = true;

                    } else {

                        disabledTieneAveria = false;
                    }
                }

                totalRegistros = (int)_result.Paginado.TotalRegistros;

            }

        }

        isLoading = false; 

        await InvokeAsync(StateHasChanged);
    } 

    private async void  ShowMonitorRecepcionSelected() {

       //Console.WriteLine($"Valor del SelecctBar: {valEstadoRecepcion}");

        if (!valEstadoRecepcion.Equals(0)) {

            await LoadData(_args);

        }

    }

    private void OnClick(string text)
    {
        NotificationService.Notify(new NotificationMessage 
        { 
            Severity = NotificationSeverity.Info, 
            Summary = "Button Clicked", 
            Detail = text }
        );
    }

    private void OnClickNavigationManager(string route) {

        navigationManager.NavigateTo($"/{route}");

    }

    private async Task LoadStateAsync()
    {
        await Task.CompletedTask;

        var result = await JSRuntime.InvokeAsync<string>("window.localStorage.getItem", "MonitorRecepcionMercancia");
        if (!string.IsNullOrEmpty(result))
        {
            _monitorRecepcionMercancia = System.Text.Json.JsonSerializer.Deserialize<MonitorRecepcionMercancia>(result);
        }
    }

    private async Task SaveStateAsync()
    {
        await Task.CompletedTask;

        await JSRuntime.InvokeVoidAsync("window.localStorage.setItem", "MonitorRecepcionMercancia", System.Text.Json.JsonSerializer.Serialize<MonitorRecepcionMercancia>(_monitorRecepcionMercancia));
    }

    private async Task LoadStateRecepcionAsync()
    {
        await Task.CompletedTask;

        var resultListRecepcion = await JSRuntime.InvokeAsync<string>("window.localStorage.getItem", "ListaMonitorRecepcionMercancia");
        if (!string.IsNullOrEmpty(resultListRecepcion))
        {
            _listaMonitorRecepcionMercancia = System.Text.Json.JsonSerializer.Deserialize<List<MonitorRecepcionMercancia>>(resultListRecepcion);
        }
    }

    private async Task SaveStateRecepcionAsync()
    {
        await Task.CompletedTask;

        await JSRuntime.InvokeVoidAsync("window.localStorage.setItem", "ListaMonitorRecepcionMercancia", System.Text.Json.JsonSerializer.Serialize<List<MonitorRecepcionMercancia>>(_listaMonitorRecepcionMercancia));
    }


    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);
        
    }

    async Task BusyDialog(string message)
    {
        await DialogService.OpenAsync("", ds =>
        {
            RenderFragment content = b =>
            {
                b.OpenElement(0, "RadzenRow");

                b.OpenElement(1, "RadzenColumn");
                b.AddAttribute(2, "Size", "12");

                b.AddContent(3, message);

                b.CloseElement();
                b.CloseElement();
            };
            return content;
        }, new DialogOptions() { ShowTitle = false, Style = "min-height:auto;min-width:auto;width:auto", CloseDialogOnEsc = false });
    }

}
