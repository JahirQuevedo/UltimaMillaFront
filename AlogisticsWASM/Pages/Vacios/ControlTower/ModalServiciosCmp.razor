@page "/servicios"

@using ALOG.Modelos.Modelos.Catalogos

<div>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
        <RadzenText TextStyle="TextStyle.Body1" TextAlign="TextAlign.Center">
            Tarifario de sevicios correspondiente a la aduana de <strong>@AduanaNombre</strong>
            </RadzenText>
    </RadzenStack>
    <RadzenRow JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Gap="2rem">
        <RadzenColumn Size="12">
            <RadzenStack>

                <RadzenDataGrid @ref="_gridServicios"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                SelectionMode="DataGridSelectionMode.Single"
                                @bind-Value=@_serviciosSeleccionados
                                FilterMode="FilterMode.Simple"
                                LogicalFilterOperator="LogicalFilterOperator.And"
                                AllowColumnResize="true"
                                AllowFiltering="true"
                                AllowSorting="true"
                                ColumnWidth="200px"
                                AllowPaging="true"
                                Data="@_tarifarioServicios"
                                PageSize="5">
                    <Columns>
                        @* <RadzenDataGridColumn TItem="CatLineaNegocioTariPrecio" Title="nombre" Property="servicio.catLineaNegocioTarifa.catServicios.Nombre" Filterable="true">
                            <Template Context="servicio">@servicio.catLineaNegocioTarifa.catServicios.Nombre</Template>
                        </RadzenDataGridColumn> *@
                        <RadzenDataGridColumn TItem="CatLineaNegocioTariPrecio" Title="Nombre" Filterable="true">
                            <Template Context="servicio">@servicio.catLineaNegocioTarifa.catServicios.Nombre</Template>
                            <FilterTemplate>
                                <RadzenTextBox Style="width:100%"
                                               @bind-Value="_nombreFiltro"
                                               Change="@((args) => FiltrarNombre())" />
                            </FilterTemplate>
                        </RadzenDataGridColumn>


                        <RadzenDataGridColumn TItem="CatLineaNegocioTariPrecio" Title="Subtotal">
                            <Template Context="servicio">
                                @String.Format(new System.Globalization.CultureInfo("es-MX"), "{0:C}", servicio.Precio)
                            </Template>
                            <EditTemplate Context="servicio">
                                <RadzenNumeric @bind-Value="servicio.Precio" Style="width:100%" InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select freight" }})" />
                            </EditTemplate>

                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Context="servicio" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="100px">
                            <Template Context="servicio">
                                <RadzenButton Icon="edit" Disabled="EsServicioCotizacion(servicio)" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(servicio))" @onclick:stopPropagation="true" />
                            </Template>
                            <EditTemplate Context="servicio">
                                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(servicio))" aria-label="Save" />
                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(servicio))" aria-label="Cancel" />

                            </EditTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenColumn>


        <RadzenColumn Size="12" class="rz-text-align-center rz-p-2">
            <RadzenButton Click=@(args => Aceptar()) Text="Aceptar" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton Click=@(args => Cancelar()) Text="Cancelar" ButtonStyle="ButtonStyle.Secondary" />
        </RadzenColumn>

    </RadzenRow>
</div>
