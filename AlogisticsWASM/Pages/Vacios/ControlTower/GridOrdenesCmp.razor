<RadzenDataGrid @ref="_gridOrdenes"
FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
AllowRowSelectOnRowClick="@_allowRowSelectOnRowClick"
FilterPopupRenderMode="PopupRenderMode.OnDemand"
SelectionMode="DataGridSelectionMode.Multiple"
ExpandMode="DataGridExpandMode.Single"
Value="@_ordenesSeleccionadas"
ValueChanged="@_onValueChanged"
Data="@(_ordenes ?? new List<Ordenes>())"
ColumnWidth="200px"
AllowFiltering="false"
AllowSorting="true"
AllowPaging="true"
PageSize="10"
RowRender="@OnRowRender">
    <Template Context="orden">
        @if (@ChildContent != null)
            @ChildContent(orden)
    </Template>

    <Columns>
        @if(MostrarChecks){
            <RadzenDataGridColumn Width="60px" Sortable="false" Filterable="false">
                <HeaderTemplate>
                    <RadzenCheckBox Value="@(_ordenesSeleccionadas == null || _ordenesSeleccionadas?.Any() != true ? false
                                        : !_ordenes.All(i => _ordenesSeleccionadas.Contains(i)) ? null
                                        : _ordenes.Any(i => _ordenesSeleccionadas.Contains(i)))"
                    Change="@(args => OnSelectAllChanged(args))"
                    InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select all items" }})"
                    TriState="false"
                    TValue="bool?"
                    TabIndex="-1" />
                </HeaderTemplate>
                <Template Context="data">
                    <RadzenCheckBox Value="@(_ordenesSeleccionadas != null && _ordenesSeleccionadas.Contains(data))"
                    InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select item" }})"
                    Change=@(args => { if(!_allowRowSelectOnRowClick) { _gridOrdenes.SelectRow(data); }})
                    TriState="false"
                    TabIndex="-1"
                    TValue="bool" />
                </Template>
            </RadzenDataGridColumn>
        }

        <RadzenDataGridColumn TItem="Ordenes" Title="Orden">
            <Template Context="orden">@orden.IdOrden</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Ordenes" Title="F. Solicitud">
            <Template Context="orden">@orden.FechaRegistro</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Ordenes" Title="Ref. Alo">
            <Template Context="orden">@orden.ReferenciaALO</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Ordenes" Title="Aduana">
            <Template Context="orden">@orden?.catAduana?.Nombre</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="Ordenes" Title="Cliente solicitante">
            <Template Context="orden">@orden?.catClientes?.RazonSocial</Template>
        </RadzenDataGridColumn>
        @if (MostrarBotonesAccion) {
            <RadzenDataGridColumn Context="orden" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="80px">
                    <Template Context="orden">
                    <RadzenButton  Icon="cancel" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => CancelarOrden(orden))" @onclick:stopPropagation="true" />
                </Template>
                <EditTemplate Context="orden">
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => CancelarOrden(orden))" aria-label="Delete" />
                </EditTemplate>
            </RadzenDataGridColumn>
        }
        </Columns>
    </RadzenDataGrid>
@* } *@
