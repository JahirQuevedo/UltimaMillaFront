@page "/contenedores"

@using ALOG.Modelos.Modelos.Catalogos
@using ALOG.Modelos.Modelos.Vacios

<style>
    :root {
        --rz-grid-header-color: white;
        --rz-grid-header-background-color: darkred;
    }
</style>

<RadzenDataGrid @ref="_gridContenedores"
                AllowRowSelectOnRowClick="@_allowRowSelectOnRowClick"
                SelectionMode="DataGridSelectionMode.Multiple"
                Value="@_contenedoresSeleccionados"
                ValueChanged="@_onValueChanged"
                Data="@_contenedores"
                ColumnWidth="200px"
                AllowFiltering="false"
                AllowSorting="true"
                AllowPaging="true"
                PageSize="10">

    <Columns>

        <RadzenDataGridColumn Width="60px" Sortable="false">
            <HeaderTemplate>
                <RadzenCheckBox Value="@(_contenedoresSeleccionados == null || _contenedoresSeleccionados?.Any() != true ? false 
                                : !_contenedores.All(i => _contenedoresSeleccionados.Contains(i)) ? null 
                                : _contenedores.Any(i => _contenedoresSeleccionados.Contains(i)))"
                                Change="@(args => OnSelectAllChanged(args))"
                                InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select all items" }})"
                                TriState="false"
                                TValue="bool?" 
                                TabIndex="-1" />
            </HeaderTemplate>
            <Template Context="data">
                <RadzenCheckBox Value="@(_contenedoresSeleccionados != null && _contenedoresSeleccionados.Contains(data))"
                                InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select item" }})"
                                Change=@(args => { if(!_allowRowSelectOnRowClick) { _gridContenedores.SelectRow(data); }})
                                TriState="false"
                                TabIndex="-1"
                                TValue="bool"  />
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="PeticionesContenedores" Title="Contenedor" Filterable="true">
            <Template Context="contenedor">@contenedor?.Contenedor</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="PeticionesContenedores" Title="Tipo cont.">
            <Template Context="contenedor">@contenedor?.catTipoContenedor?.Nomenclatura</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="PeticionesContenedores" Title="BL">
            <Template Context="contenedor">@contenedor?.BL</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="PeticionesContenedores" Title="Ref. Cliente">
            <Template Context="contenedor">@contenedor?.RefenciaCliente</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="PeticionesContenedores" Title="Cliente">
            <Template Context="contenedor">@contenedor?.Cliente_RazonSocial</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="PeticionesContenedores" Title="Consignado">
            <Template Context="contenedor">@contenedor?.Consignado_RazonSocial</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="PeticionesContenedores" Title="Naviera">
            <Template Context="contenedor">@contenedor?.Naviera_RazonSocial</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="PeticionesContenedores" Title="Patio">
            <Template Context="contenedor">@contenedor?.Patio_RazonSocial</Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Context="contenedor" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Width="200px">            
            <Template Context="contenedor">
                <RadzenButton Icon="add_circle" Text="Ver servicios" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" title="Servicios" Click="@(args => AbrirModalDocumentosServicios(contenedor))" />
                <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => CancelarContenedor(contenedor))" @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="contenedor">
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => CancelarContenedor(contenedor))" aria-label="Delete" />
            </EditTemplate>
        </RadzenDataGridColumn>

    </Columns>
</RadzenDataGrid>