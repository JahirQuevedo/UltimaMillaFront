RowUpdate="@OnUpdateRow" Sort="@(args => Reset())" Page="@(args => Reset())" Filter="@(args => Reset())"
Data="@lstpeticionesServicio" CellClick="@OnCellClick">
    <Template Context="servicios">

        <RadzenBadge BadgeStyle="BadgeStyle.Base" Text="EXPEDIENTE DIGITAL" />
        <GridDocumentosPorServicioCMP paramDocumentos="servicios.Documentos"></GridDocumentosPorServicioCMP>
        @* <RadzenDataGrid AllowFiltering="true" AllowPaging="true" AllowSorting="true"
        Data="servicios.Documentos">

        <Columns>
        <RadzenDataGridColumn Property="@nameof(PeticionesDocumentos.FechaRegistro)" FormatString="{0:d}" Title="F.Solicitud" Width="80px" />
        <RadzenDataGridColumn Property="@nameof(PeticionesDocumentos.CatDocumento)" Title="Servicio" Width="120px">
        <Template Context="data">
        @(data.CatDocumento.NombreDocumento)
        </Template>
