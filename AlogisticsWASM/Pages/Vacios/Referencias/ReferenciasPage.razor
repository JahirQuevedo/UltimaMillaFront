@page "/referenciasRZ"

@using ALOG.Modelos.Modelos.DTO.Respuestas
@using ALOG.Modelos.Modelos.Vacios
@using ALOGRepositorios.Services.Login
@using ALOGRepositorios.Services.Peticiones.IPeticiones;
@using ALOGRespositorios.Modelos.Dtos.Control
@using AlogisticsWASM.Layout.Generics
@using AlogisticsWASM.Pages.Vacios.Contenedores;
@using AlogisticsWASM.Layout.Vacios.Referencias
@using Microsoft.AspNetCore.Authorization
@inject NotificationService NotificationService
@inject SweetAlertService Swal;
@inject UsuarioTokenDTO _UsuarioTokenDTO
@inject IConfiguration configuration
@inject Radzen.DialogService DialogService






@*  @attribute [Authorize(Roles = "ADMIN")]  *@
@attribute [Authorize]

<style>
    :root {
        --rz-grid-header-color: white;
        --rz-grid-header-background-color: darkred;
    }


    /*   .rz-state-highlight td {
                background-color: chocolate;
            }*/

    .rz-grid-table {
        width: unset;
    }
    /*.custom-header {
                font-weight: bold;
                background-color: #f0f0f0;
            }  */
</style>
@if (position == 0)
{
    <style>
        .rz-panel-titlebar {
            flex-direction: row-reverse;
            justify-content: left;
        }
    </style>
}

<div class="content">
    <div class="row g-3 mb-2">
        <div class="rz-m-2">
            <RadzenBreadCrumb>
                <RadzenBreadCrumbItem Path="/" Text="Home" />
                <RadzenBreadCrumbItem Text="Vacíos" />
            </RadzenBreadCrumb>
        </div>
        <div class="col-auto">
            <h4 class="mb-0">Servicios de vacíos</h4>
        </div>
    </div>
    <RadzenStack Gap="1rem">

        <RadzenPanel AllowCollapse="true" class="rz-my-2 rz-mx-auto" Style="width: 100%;"
                     Expand=@(() => Change("Panel expanded")) Collapse=@(() => Change("Panel collapsed"))>
            <HeaderTemplate>
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-display-flex rz-align-items-center rz-m-0">
                    <RadzenIcon Icon="filter_alt" class="rz-me-1" /><b>Filtros de Consulta</b>
                </RadzenText>
            </HeaderTemplate>
            <ChildContent>
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenRow JustifyContent="JustifyContent.Normal" class="rz-my-2">

                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.5rem;" Wrap="FlexWrap.Wrap">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                                <RadzenLabel Text="Contenedor:" Component="contenedor" />
                                <RadzenTextBox Style="width: 100%" aria-label="Default TextBox" Name="contenedor" @bind-Value="strPcontenedor" />
                                @*  <RadzenDropDown @bind-Value="@logicalFilterOperator" TextProperty="Text" ValueProperty="Value" Name="operator" Change=@(args => grid.Reload())
                                Data="@(Enum.GetValues(typeof(LogicalFilterOperator)).Cast<LogicalFilterOperator>().Select(t => new { Text = $"{t}", Value = t }))" /> *@
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                                <RadzenLabel Text="Cliente:" Component="CatClienteId2" />
                                @* <RadzenTextBox Style="width: 100%" aria-label="Default TextBox" Name="cliente" @bind-Value="strPcliente" /> *@
                                <RadzenAutoComplete @bind-Value=@strPcliente Data=@respListarCoincidencias TextProperty="@nameof(RespListarCoincidenciasDTO.RazonSocial)"
                                                    ValueProperty="@nameof(RespListarCoincidenciasDTO.Id)" Change=@AutoCompleteOnClienteChange LoadData=@AutoCompleteOnLoadCliente Style="width: 100%"
                                                    InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Company Name" }})"
                                                    Name="CatClienteId2" />
                            </RadzenStack>

                            @*   <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                            <RadzenLabel Text="F.Cierre" Component="FSolicitudIni" />
                            <RadzenDatePicker @bind-Value="@dFSolicitudCierre" DateFormat="MM/dd/yyyy" Name="FSolicitudCierre" />
                            </RadzenStack> *@
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                                <RadzenLabel Text="Ref.Alo:" Component="refalo" />
                                <RadzenTextBox Style="width: 100%" aria-label="Default TextBox" Name="refalo" @bind-Value="strPrefalo" />
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                                <RadzenLabel Text="Ref.Cliente:" Component="refcliente" />
                                <RadzenTextBox Style="width: 100%" aria-label="Default TextBox" Name="refcliente" @bind-Value="strPrefcliente" />

                            </RadzenStack>



                        </RadzenStack>
                    </RadzenRow>
                    <RadzenRow JustifyContent="JustifyContent.Normal" class="rz-my-2">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.5rem;" Wrap="FlexWrap.Wrap">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                                <RadzenLabel Text="F.Solicitud Ini" Component="FSolicitudIni" />
                                <RadzenDatePicker @bind-Value="@dFSolicitudIni" DateFormat="dd/MM/yyyy" Name="FSolicitudIni" />
                            </RadzenStack>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                                <RadzenLabel Text="F.Solicitud Fin" Component="FSolicitudFin" />
                                <RadzenDatePicker @bind-Value="@dFSolicitudFin" DateFormat="dd/MM/yyyy" Name="FSolicitudFin" />
                            </RadzenStack>
                            @* <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                            <RadzenLabel Text="Proveedor:" Component="proveedor" />
                            <RadzenTextBox Style="width: 100%" aria-label="Default TextBox" Name="proveedor" @bind-Value="strProveedor" />
                            </RadzenStack> *@
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                                <RadzenLabel Text="Naviera:" Component="AutoCompleteNaviera" />

                                <RadzenAutoComplete @bind-Value=@strPNaviera Data=@respListarCoincidenciasNavGen TextProperty="@nameof(RespuestaGenericaCatalogosDTO.Nombre)"
                                                    ValueProperty="@nameof(RespuestaGenericaCatalogosDTO.Id)" Change=@AutoCompleteOnNavieraChange LoadData=@AutoCompleteOnLoadNaviera Style="width: 100%"
                                                    InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Naviera de Operación" }})"
                                                    Name="AutoCompleteNaviera" />
                            </RadzenStack>

                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                                <RadzenLabel Text="Patio:" Component="AutoCompletepatio" />

                                <RadzenAutoComplete @bind-Value=@strPPatio Data=@respListarCoincidenciasGen TextProperty="@nameof(RespuestaGenericaCatalogosDTO.Nombre)"
                                                    ValueProperty="@nameof(RespuestaGenericaCatalogosDTO.Id)" Change=@AutoCompleteOnPatioChange LoadData=@AutoCompleteOnLoadPatio Style="width: 100%"
                                                    InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Patio de Operación" }})"
                                                    Name="AutoCompletepatio" />
                            </RadzenStack>

                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                                <RadzenLabel Text="Aduana:" Component="DropDownAduana" />
                                <RadzenDropDown @bind-Value=@strPAduana Data=@lstAduanas.Select(x =>x.Nombre) Change=@DropDownOnAduanaChange Style="width: 100%; max-width: 200px;" Name="DropDownAduana" AllowClear=true />

                            </RadzenStack>


                            <RadzenButton Text="Enviar" Click="@(args => EnviarDatos())" />
                        </RadzenStack>
                    </RadzenRow>
                </RadzenCard>
            </ChildContent>
        </RadzenPanel>



        @if (isLoading)
        {



            <div class="rz-my-auto rz-mx-auto rz-p-4 rz-p-md-12" style="max-width: 600px;">
                <RadzenProgressBarCircular ShowValue="true" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" ProgressBarStyle="ProgressBarStyle.Primary">
                    <Template>Wait</Template>
                </RadzenProgressBarCircular>
            </div>
        }

        @if (!isLoading)
        {
            <RadzenStack Orientation="Orientation.Horizontal" class=".rz-my-0">
                @* <RadzenButton Click=@(args => CrearReferencia()) Text="Crear" Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Style="width:200px;" /> *@
                <RadzenButton Click=@(args => CargaPlantilla()) Text="Crear Orden" Icon="add_circle" ButtonStyle="ButtonStyle.Secondary" Style="width:200px;" />
            </RadzenStack>

            <RadzenDataGrid @ref="grid2" AllowFiltering="true" AllowAlternatingRows="false" AllowPaging="true" PageSize="20" AllowSorting="true" RowRender="@RowRender" ExpandMode="@expandMode"
                            Data="@_IEReferencias" TItem="RespObtenerReferenciasDTO" Render="OnCustomersDataGridRender" SelectionMode="DataGridSelectionMode.Single">
                <Template Context="referencias">

                    @*   <RadzenCard Variant="Variant.Outlined">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.5rem;" Wrap="FlexWrap.Wrap">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem;">
                <RadzenBadge BadgeStyle="BadgeStyle.Base" Text="CONTENEDOR" />
                </RadzenStack>
                <RadzenButton Text="Cerrar todos" Click="@(args => CerrarTodosContenedores())" />
                <RadzenButton Click=@(args => CerrarTodosContenedores()) Text="Cerrar todos" ButtonStyle="ButtonStyle.Base" />
                </RadzenStack>
                </RadzenCard> *@

                    @if (referencias.IdCatEstadoReferencia != 7)
                    {
                        blhabilitarActualizar = @dicAcceso["ACTUALIZAR"];
                    }
                    else
                    {
                        blhabilitarActualizar = false;
                    }

                    <GridContenedoresCmp paramMostraServicios=false
                                         ParamdicAcceso=@dicAcceso
                                         ParamUsuarioTokenDTO=_UsuarioTokenDTO
                                         paramMostarControles=blhabilitarActualizar
                                         paramIdOrden=referencias.IdOrden
                                         paramIdReferencia=referencias.IdReferencia
                                         paramContenedores="@_IEReferencias.Where(x =>x.IdReferencia==referencias.IdReferencia).SelectMany(refDto => refDto.peticionesContenedores ?? new List<PeticionesContenedores>()).AsQueryable().ToList()"></GridContenedoresCmp>
                </Template>
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(RespObtenerReferenciasDTO.IdOrden)" Title="Orden" Width="50px" />
                    <RadzenDataGridColumn Property="@nameof(RespObtenerReferenciasDTO.FechaSolicitud)" Title="F.Solicitud" FormatString="{0:d}" Width="100px" />
                    <RadzenDataGridColumn Property="@nameof(RespObtenerReferenciasDTO.ReferenciaALO)" Title="Ref.ALO" Width="100px" />
                    @* <RadzenDataGridColumn Property="@nameof(RespObtenerReferenciasDTO.IdReferencia)" Title="Id.Ref." Width="50px" /> *@
                    <RadzenDataGridColumn Property="@nameof(RespObtenerReferenciasDTO.Ticket)" Title="Ticket" Width="50px" />
                    <RadzenDataGridColumn Property="@nameof(RespObtenerReferenciasDTO.Aduana)" Title="Aduana" Width="50px" />


                    <RadzenDataGridColumn Property="@nameof(RespObtenerReferenciasDTO.Transporte_RazonSocial)" Title="Emp.Solicitante" Width="100px" />
                    @* <RadzenDataGridColumn Property="@nameof(RespObtenerReferenciasDTO.EstadoReferencia)" Title="Estado" Width="100px" /> *@
                    <RadzenDataGridColumn Property="@nameof(RespObtenerReferenciasDTO.EstadoReferencia)" Filterable="false" Title="Estado" Width="80px">
                        <Template Context="data">
                            <RadzenBadge BadgeStyle="@(objutileriasPage.GetBadgeStyle2(data.IdCatReferenciaEstado.ToString()))" Shade="Shade.Darker" IsPill="true" Text="@objutileriasPage.GetEstado(data.IdCatReferenciaEstado)" class="rz-ms-2" />
                        </Template>
                        <HeaderTemplate>
                            <span class="custom-header">Estado</span>
                        </HeaderTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Context="Referencia" Width="40px" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="Referencia">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Dark" Variant="Variant.Filled" Size="ButtonSize.Small" Click="@(args => OpenModal(Referencia.IdOrden))" @onclick:stopPropagation="true">
                            </RadzenButton>
                            @* <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(order))" @onclick:stopPropagation="true">
                        </RadzenButton> *@
                        </Template>
                        @* <EditTemplate Context="order">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(order))" aria-label="Save">
                    </RadzenButton>
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(order))" aria-label="Cancel">
                    </RadzenButton>
                    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Variant="Variant.Flat" Shade="Shade.Lighter" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(order))" aria-label="Delete">
                    </RadzenButton>
                    </EditTemplate> *@
                    </RadzenDataGridColumn>
                    @* <RadzenDataGridColumn Property="@nameof(Customer.ContactName)" Title="ContactName" Width="200px" />
                <RadzenDataGridColumn Property="@nameof(Customer.ContactTitle)" Title="ContactTitle" Width="200px" />
                <RadzenDataGridColumn Property="@nameof(Customer.City)" Title="City" Width="100px" />
                <RadzenDataGridColumn Property="@nameof(Customer.Country)" Title="Country" Width="100px" /> *@
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenStack>

</div>


