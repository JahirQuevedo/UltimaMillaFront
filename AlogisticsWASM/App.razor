@using ALOGRepositorios.Services.Login
@using ALOGRepositorios.Services.Login.ILogin
@using ALOGRespositorios.Modelos.Dtos.Control
@inject IJSRuntime _jsRuntime
@inject UsuarioTokenDTO _UsuarioTokenDTO
@inject ILoginService loginService



    <Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <Authorizing>
                <p>Por favor, espere mientras autorizamos el usuario</p>
            </Authorizing>
            <NotAuthorized>
                @{
                    
                }
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <CascadingAuthenticationState>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Error, no se encuentra nada en esta dirección</p>
            </LayoutView>
        </CascadingAuthenticationState>
    </NotFound>
</Router>

 
@code{
    #region Init
    protected override async Task OnInitializedAsync()
    {
        #region ValidarAcceso
        try
        {
            var token = await _jsRuntime.InvokeAsync<string>("localStorage.getItem", "JWT Token");
            ////Console.WriteLine("Userservice:" + token);
            if (!string.IsNullOrEmpty(token))
            {
                if (_UsuarioTokenDTO is null)
                {
                    ////Console.WriteLine($"ENTRO APP RAZOR");
                     _UsuarioTokenDTO = await loginService.ObtenerdatosToken();
                    //await UserService.InitializeAsync();
                    ////Console.WriteLine($"SALIO APP RAZOR {_UsuarioTokenDTO.Nombre}");
                }
                else
                {
                    ////Console.WriteLine($"INIT APP RAZOR {_UsuarioTokenDTO.Nombre}");
                }
            }


        }catch (Exception ex)
        {
            ////Console.WriteLine("APP.RAZOR:"+ex.Message);
        }

        #endregion ValidarAcceso





    }
    #endregion Init
}
